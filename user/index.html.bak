    // Haversine formula for distance in meters
    function calculateDistance(lat1, lon1, lat2, lon2) {
      const R = 6371e3; // Earth radius in meters
      const φ1 = lat1 * Math.PI / 180;
      const φ2 = lat2 * Math.PI / 180;
      const Δφ = (lat2 - lat1) * Math.PI / 180;
      const Δλ = (lon2 - lon1) * Math.PI / 180;

      const a = Math.sin(Δφ/2) * Math.sin(Δφ/2) +
                Math.cos(φ1) * Math.cos(φ2) *
                Math.sin(Δλ/2) * Math.sin(Δλ/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      return Math.round(R * c);
    }

    // Number to Indian Words converter
    function numberToWords(num) {
      const a = ['', 'One ', 'Two ', 'Three ', 'Four ', 'Five ', 'Six ', 'Seven ', 'Eight ', 'Nine ', 'Ten ', 'Eleven ', 'Twelve ', 'Thirteen ', 'Fourteen ', 'Fifteen ', 'Sixteen ', 'Seventeen ', 'Eighteen ', 'Nineteen '];
      const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

      function inWords(n) {
        if ((n = n.toString()).length > 9) return 'Overflow';
        const nArr = ('000000000' + n).substr(-9).match(/^(\d{2})(\d{2})(\d{2})(\d{1})(\d{2})$/);
        if (!nArr) return '';
        let str = '';
        str += (Number(nArr[1]) !== 0) ? (a[Number(nArr[1])] || b[nArr[1][0]] + ' ' + a[nArr[1][1]]) + 'Crore ' : '';
        str += (Number(nArr[2]) !== 0) ? (a[Number(nArr[2])] || b[nArr[2][0]] + ' ' + a[nArr[2][1]]) + 'Lakh ' : '';
        str += (Number(nArr[3]) !== 0) ? (a[Number(nArr[3])] || b[nArr[3][0]] + ' ' + a[nArr[3][1]]) + 'Thousand ' : '';
        str += (Number(nArr[4]) !== 0) ? (a[Number(nArr[4])] || b[nArr[4][0]] + ' ' + a[nArr[4][1]]) + 'Hundred ' : '';
        str += (Number(nArr[5]) !== 0) ? ((str !== '') ? 'and ' : '') + (a[Number(nArr[5])] || b[nArr[5][0]] + ' ' + a[nArr[5][1]]) : '';
        return str.trim();
      }
      return inWords(num) + ' Rupees Only';
    }

    // =========================================================================
    // MAIN APP ROOT COMPONENT
    // =========================================================================
    function App() {
      // 1. Session & Auth State
      const [currentUser, setCurrentUser] = useState(() => {
        const saved = localStorage.getItem('sora_active_user');
        return saved ? JSON.parse(saved) : DEFAULT_USERS.employee;
      });
      const [isLoggedIn, setIsLoggedIn] = useState(false);
      const [currentScreen, setCurrentScreen] = useState('welcome');

      // 2. Active Tab
      const [activeTab, setActiveTab] = useState('dashboard');

      // 3. HR Settings State (Core setting requirement from prompt!)
      const [hrSettings, setHrSettings] = useState(() => {
        const saved = localStorage.getItem('sora_hr_settings');
        return saved ? JSON.parse(saved) : DEFAULT_HR_SETTINGS;
      });

      // 4. Live Attendance Shift State
      const [shiftState, setShiftState] = useState(() => {
        const saved = localStorage.getItem('sora_shift_state');
        return saved ? JSON.parse(saved) : {
          status: 'NOT_CLOCKED_IN', // 'NOT_CLOCKED_IN' | 'WORKING' | 'ON_BREAK' | 'COMPLETED'
          clockInTime: null,
          clockOutTime: null,
          breakStartTime: null,
          totalBreakSeconds: 0,
          currentBreakName: '',
          todayPunches: 0,
          capturedSelfie: null,
          geoCoords: null,
          distanceFromOffice: null
        };
      });

      // 5. Attendance History Logs
      const [attendanceLogs, setAttendanceLogs] = useState(() => {
        const saved = localStorage.getItem('sora_attendance_logs');
        return saved ? JSON.parse(saved) : INITIAL_ATTENDANCE_LOGS;
      });

      // 6. Leave Balances & Requests
      const [leaveQuotas, setLeaveQuotas] = useState(() => {
        const saved = localStorage.getItem('sora_leave_quotas');
        return saved ? JSON.parse(saved) : INITIAL_LEAVE_QUOTAS;
      });
      const [leaveRequests, setLeaveRequests] = useState(() => {
        const saved = localStorage.getItem('sora_leave_requests');
        return saved ? JSON.parse(saved) : INITIAL_LEAVE_REQUESTS;
      });

      // 7. Payroll Ledger
      const [payrollData, setPayrollData] = useState(() => {
        const saved = localStorage.getItem('sora_payroll_data');
        return saved ? JSON.parse(saved) : INITIAL_PAYROLL_MASTER;
      });

      // 8. Live Clock Ticker
      const [currentTimeStr, setCurrentTimeStr] = useState('');
      const [currentDateStr, setCurrentDateStr] = useState('');
      const [elapsedShiftSeconds, setElapsedShiftSeconds] = useState(0);
      const [elapsedBreakSeconds, setElapsedBreakSeconds] = useState(0);

      // 9. Modals State
      const [isSelfieModalOpen, setIsSelfieModalOpen] = useState(false);
      const [isQrModalOpen, setIsQrModalOpen] = useState(false);
      const [isBreakModalOpen, setIsBreakModalOpen] = useState(false);
      const [isApplyLeaveModalOpen, setIsApplyLeaveModalOpen] = useState(false);
      const [isHrSettingsModalOpen, setIsHrSettingsModalOpen] = useState(false);
      const [previewSelfieUrl, setPreviewSelfieUrl] = useState(null);

      // 10. Toasts notification system
      const [toasts, setToasts] = useState([]);
      const addToast = (title, message, type = 'success') => {
        const id = Date.now() + Math.random();
        setToasts(prev => [...prev, { id, title, message, type }]);
        setTimeout(() => {
          setToasts(prev => prev.filter(t => t.id !== id));
        }, 4500);
      };

      // Sync state to localStorage
      useEffect(() => {
        localStorage.setItem('sora_active_user', JSON.stringify(currentUser));
        localStorage.setItem('sora_is_logged_in', isLoggedIn ? 'true' : 'false');
      }, [currentUser, isLoggedIn]);

      useEffect(() => {
        localStorage.setItem('sora_hr_settings', JSON.stringify(hrSettings));
      }, [hrSettings]);

      useEffect(() => {
        localStorage.setItem('sora_shift_state', JSON.stringify(shiftState));
      }, [shiftState]);

      useEffect(() => {
        localStorage.setItem('sora_attendance_logs', JSON.stringify(attendanceLogs));
      }, [attendanceLogs]);

      useEffect(() => {
        localStorage.setItem('sora_leave_requests', JSON.stringify(leaveRequests));
      }, [leaveRequests]);

      useEffect(() => {
        localStorage.setItem('sora_leave_quotas', JSON.stringify(leaveQuotas));
      }, [leaveQuotas]);

      useEffect(() => {
        localStorage.setItem('sora_payroll_data', JSON.stringify(payrollData));
      }, [payrollData]);

      // Clock Ticker Effect
      useEffect(() => {
        const updateClocks = () => {
          const now = new Date();
          setCurrentTimeStr(now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true }));
          setCurrentDateStr(now.toLocaleDateString('en-IN', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' }));

          if (shiftState.status === 'WORKING' && shiftState.clockInTime) {
            const inDate = new Date(shiftState.clockInTime);
            const totalSec = Math.max(0, Math.floor((now - inDate) / 1000) - shiftState.totalBreakSeconds);
            setElapsedShiftSeconds(totalSec);
          }

          if (shiftState.status === 'ON_BREAK' && shiftState.breakStartTime) {
            const breakDate = new Date(shiftState.breakStartTime);
            setElapsedBreakSeconds(Math.max(0, Math.floor((now - breakDate) / 1000)));
          }
        };

        updateClocks();
        const interval = setInterval(updateClocks, 1000);
        return () => clearInterval(interval);
      }, [shiftState]);

      // Handle Quick Role Switch (For reviewer to test both Employee & Admin flows!)
      const handleRoleSwitch = (newRole) => {
        if (newRole === 'admin') {
          setCurrentUser(DEFAULT_USERS.admin);
          addToast('Role Switched', 'Switched to HR / Administrator Console (Aarav Sharma)', 'info');
        } else {
          setCurrentUser(DEFAULT_USERS.employee);
          addToast('Role Switched', 'Switched to Employee Self-Service (Pooja Iyer)', 'info');
        }
      };

      // -----------------------------------------------------------------------
      // CLOCK-IN FLOW WITH HR SETTINGS (Geo & Selfie verification check)
      // -----------------------------------------------------------------------
      const initiateClockIn = () => {
        // Step 1: Check if Selfie verification is REQUIRED by HR
        if (hrSettings.requireSelfie) {
          setIsSelfieModalOpen(true);
          return;
        }

        // Step 2: Check if QR Scan is REQUIRED by HR
        if (hrSettings.requireQrScan) {
          setIsQrModalOpen(true);
          return;
        }

        // Step 3: Direct Clock In with Geolocation
        finalizeClockIn(null);
      };

      const finalizeClockIn = (selfieDataUrl) => {
        const now = new Date();
        const timeFormatted = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });

        // Retrieve Geolocation if enabled by HR
        if (hrSettings.requireGeo && navigator.geolocation) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const lat = pos.coords.latitude;
              const lng = pos.coords.longitude;
              const dist = calculateDistance(lat, lng, hrSettings.officeLat, hrSettings.officeLng);
              completeClockInRecord(now, timeFormatted, selfieDataUrl, { lat, lng }, dist);
            },
            (err) => {
              // Graceful fallback coordinates with mock distance (so testing never blocks!)
              const mockLat = hrSettings.officeLat + 0.00015;
              const mockLng = hrSettings.officeLng + 0.00018;
              const dist = 28; // within 100m
              completeClockInRecord(now, timeFormatted, selfieDataUrl, { lat: mockLat, lng: mockLng }, dist);
            },
            { enableHighAccuracy: true, timeout: 5000 }
          );
        } else {
          completeClockInRecord(now, timeFormatted, selfieDataUrl, null, null);
        }
      };

      const completeClockInRecord = (now, timeFormatted, selfieDataUrl, coords, dist) => {
        const isLate = now.getHours() > 9 || (now.getHours() === 9 && now.getMinutes() > 45);
        const status = isLate ? 'Late' : 'Present';
        const locationStr = dist !== null 
          ? `BKC Office (${dist}m away · ${dist <= hrSettings.allowedRadiusMeters ? 'In Geofence' : 'Outside Geofence'})` 
          : 'Verified via ESS Portal';

        setShiftState(prev => ({
          ...prev,
          status: 'WORKING',
          clockInTime: now.toISOString(),
          clockOutTime: null,
          todayPunches: prev.todayPunches + 1,
          capturedSelfie: selfieDataUrl,
          geoCoords: coords,
          distanceFromOffice: dist
        }));

        // Add or update today's log in attendance history
        const newLog = {
          id: 'ATT-' + now.toISOString().slice(0, 10).replace(/-/g, ''),
          date: now.toISOString().slice(0, 10),
          displayDate: now.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) + ' (Today)',
          inTime: timeFormatted,
          outTime: '--:--',
          breakMinutes: 0,
          hours: 'In Progress',
          status: status,
          location: locationStr,
          lat: coords ? coords.lat : hrSettings.officeLat,
          lng: coords ? coords.lng : hrSettings.officeLng,
          selfieUrl: selfieDataUrl,
          hasSelfie: !!selfieDataUrl,
          method: selfieDataUrl ? 'Geo + Live Selfie' : 'Touchless Geo'
        };

        setAttendanceLogs(prev => [newLog, ...prev.filter(l => l.date !== newLog.date)]);
        addToast('Clock In Successful', `Punched in at ${timeFormatted}. Shift timer is now active!`, 'success');
      };

      // -----------------------------------------------------------------------
      // BREAK MANAGEMENT FLOW
      // -----------------------------------------------------------------------
      const startBreak = (breakName = 'Lunch Break') => {
        const now = new Date();
        setShiftState(prev => ({
          ...prev,
          status: 'ON_BREAK',
          breakStartTime: now.toISOString(),
          currentBreakName: breakName
        }));
        setIsBreakModalOpen(false);
        addToast('Break Started', `Enjoy your ${breakName}! Break stopwatch is ticking.`, 'info');
      };

      const endBreak = () => {
        if (!shiftState.breakStartTime) return;
        const now = new Date();
        const breakStart = new Date(shiftState.breakStartTime);
        const durationSec = Math.max(0, Math.floor((now - breakStart) / 1000));
        const durationMin = Math.round(durationSec / 60);

        setShiftState(prev => ({
          ...prev,
          status: 'WORKING',
          breakStartTime: null,
          totalBreakSeconds: prev.totalBreakSeconds + durationSec
        }));

        // Update break in attendance log
        setAttendanceLogs(prev => prev.map((l, idx) => {
          if (idx === 0) {
            return { ...l, breakMinutes: (l.breakMinutes || 0) + durationMin };
          }
          return l;
        }));

        addToast('Break Ended', `Resumed work. Total break logged: ${durationMin} min.`, 'success');
      };

      // -----------------------------------------------------------------------
      // CLOCK-OUT FLOW
      // -----------------------------------------------------------------------
      const handleClockOut = () => {
        const now = new Date();
        const timeFormatted = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });

        let totalWorkedSeconds = 0;
        if (shiftState.clockInTime) {
          const inDate = new Date(shiftState.clockInTime);
          totalWorkedSeconds = Math.max(0, Math.floor((now - inDate) / 1000) - shiftState.totalBreakSeconds);
        }

        const hrs = Math.floor(totalWorkedSeconds / 3600);
        const mins = Math.floor((totalWorkedSeconds % 3600) / 60);
        const hoursFormatted = `${String(hrs).padStart(2, '0')}h ${String(mins).padStart(2, '0')}m`;

        setShiftState(prev => ({
          ...prev,
          status: 'COMPLETED',
          clockOutTime: now.toISOString(),
          todayPunches: prev.todayPunches + 1
        }));

        setAttendanceLogs(prev => prev.map((l, idx) => {
          if (idx === 0) {
            return {
              ...l,
              outTime: timeFormatted,
              hours: hoursFormatted
            };
          }
          return l;
        }));

        addToast('Shift Completed', `Clocked out at ${timeFormatted}. Total productive hours: ${hoursFormatted}. Have a great evening!`, 'success');
      };

      // Format seconds into HH:MM:SS
      const formatDuration = (totalSeconds) => {
        const h = Math.floor(totalSeconds / 3600);
        const m = Math.floor((totalSeconds % 3600) / 60);
        const s = totalSeconds % 60;
        return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      };

      // -----------------------------------------------------------------------
      // LEAVE MANAGEMENT HANDLERS
      // -----------------------------------------------------------------------
      const handleApplyLeave = (leaveData) => {
        const newReq = {
          id: `LV-2026-${String(Math.floor(Math.random() * 900) + 100)}`,
          empCode: currentUser.id,
          empName: currentUser.name,
          type: leaveData.type,
          dates: `${leaveData.fromDate} to ${leaveData.toDate}`,
          days: leaveData.days,
          reason: leaveData.reason,
          status: 'Pending Review',
          appliedOn: new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })
        };

        setLeaveRequests(prev => [newReq, ...prev]);
        setIsApplyLeaveModalOpen(false);
        addToast('Leave Application Submitted', `Your request for ${leaveData.days} day(s) ${leaveData.type} is submitted for HR approval.`, 'success');
      };

      const handleApproveLeave = (id) => {
        const req = leaveRequests.find(r => r.id === id);
        if (!req) return;

        setLeaveRequests(prev => prev.map(r => r.id === id ? { ...r, status: 'Approved' } : r));

        // Deduct from quota if Casual / Sick / Paid
        const codeMap = { 'Casual Leave (CL)': 'CL', 'Sick Leave (SL)': 'SL', 'Privilege / Paid Leave (PL)': 'PL' };
        const code = codeMap[req.type];
        if (code && leaveQuotas[code]) {
          setLeaveQuotas(prev => ({
            ...prev,
            [code]: {
              ...prev[code],
              remaining: Math.max(0, prev[code].remaining - req.days),
              used: prev[code].used + req.days
            }
          }));
        }

        addToast('Leave Approved', `Approved leave application #${id} for ${req.empName}.`, 'success');
      };

      const handleRejectLeave = (id) => {
        setLeaveRequests(prev => prev.map(r => r.id === id ? { ...r, status: 'Rejected' } : r));
        addToast('Leave Rejected', `Leave application #${id} was marked as rejected.`, 'info');
      };

      // -----------------------------------------------------------------------
      // ATTENDANCE XLS IMPORT HANDLER
      // -----------------------------------------------------------------------
      const handleImportAttendanceXls = (importedRows) => {
        const formatted = importedRows.map((r, idx) => ({
          id: 'XLS-' + (r.Date || new Date().toISOString().slice(0, 10)) + '-' + idx,
          date: r.Date || '2026-11-01',
          displayDate: r.Date ? `${r.Date} (Batch Import)` : 'Imported Record',
          inTime: r.ClockIn || '09:30 AM',
          outTime: r.ClockOut || '06:30 PM',
          breakMinutes: Number(r.BreakMins) || 45,
          hours: r.Hours || '08h 15m',
          status: r.Status || 'Present',
          location: 'Batch Imported via XLS',
          lat: hrSettings.officeLat,
          lng: hrSettings.officeLng,
          selfieUrl: null,
          hasSelfie: false,
          method: 'Excel Batch Upload'
        }));

        setAttendanceLogs(prev => [...formatted, ...prev]);
        addToast('XLS Upload Success', `Successfully imported ${formatted.length} attendance records into the system!`, 'success');
      };

      // Screen 1: Welcome & Onboarding
      if (currentScreen === 'welcome') {
        return (
          <WelcomeScreen 
            onNext={() => setCurrentScreen('login')}
          />
        );
      }

      // Screen 2: Dedicated Mobile Login Screen
      if (currentScreen === 'login' || !isLoggedIn) {
        return (
          <LoginScreen 
            onBack={() => setCurrentScreen('welcome')}
            onLogin={(user) => {
              setCurrentUser(user);
              setIsLoggedIn(true);
              setCurrentScreen('home');
              addToast('Welcome Back', `Signed in as ${user.name} (${user.role === 'admin' ? 'HR Administrator' : 'Employee'})`, 'success');
            }}
          />
        );
      }

      return (
        <div className="min-h-screen flex flex-col bg-brand-black text-neutral-100">
          
          {/* ================================================================= */}
          {/* 1. TOP GLOBAL NAVIGATION BAR */}
          {/* ================================================================= */}
          <header className="sticky top-0 z-40 bg-brand-surface/95 backdrop-blur-md border-b border-brand-border px-4 sm:px-6 py-2.5 flex items-center justify-between gap-4">
            
            {/* Left: Brand Logo & Company Info */}
            <div className="flex items-center gap-3">
              <a href="/user/" className="flex items-center gap-2.5 group">
                <img src="/sora-hr-logo.svg" alt="SORA HR" className="h-6 sm:h-7 w-auto" onError={(e) => { e.target.src = '/sora-hr-logo.png'; }} />
              </a>

              <div className="h-5 w-px bg-brand-border hidden md:block"></div>

              <div className="hidden lg:flex items-center gap-2 text-xs">
                <span className="font-bold text-white">Apex Global Technologies</span>
                <span className="text-neutral-500">&bull;</span>
                <span className="text-neutral-400 text-[11px]">{currentUser.shift}</span>
              </div>
            </div>

            {/* Center / Right: Live Clock & Shift Badge */}
            <div className="flex items-center gap-3">
              
              {/* Shift Clock & Live Status Pill */}
              <div className="flex items-center gap-2.5 bg-brand-dark px-3 py-1.5 rounded-xl border border-brand-border shadow-inner">
                <div className="flex items-center gap-1.5 text-xs font-mono">
                  <Icon name="clock" className="w-3.5 h-3.5 text-brand-amber" />
                  <span className="text-[9px] text-neutral-400 uppercase font-mono hidden sm:inline">IST:</span>
                  <span className="font-bold text-white">{currentTimeStr}</span>
                </div>

                <div className="h-3.5 w-px bg-brand-border"></div>

                {/* Shift Status Indicator */}
                <div className={`px-2.5 py-0.5 rounded-full text-xs font-bold border flex items-center gap-1.5 whitespace-nowrap ${
                  shiftState.status === 'WORKING' 
                    ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30'
                    : shiftState.status === 'ON_BREAK'
                    ? 'bg-amber-500/15 text-amber-300 border-amber-500/30 animate-pulse'
                    : shiftState.status === 'COMPLETED'
                    ? 'bg-sky-500/15 text-sky-300 border-sky-500/30'
                    : 'bg-neutral-800 text-neutral-400 border-neutral-700'
                }`}>
                  <span className={`w-2 h-2 rounded-full ${
                    shiftState.status === 'WORKING' ? 'bg-emerald-400 animate-ping' :
                    shiftState.status === 'ON_BREAK' ? 'bg-amber-400' :
                    shiftState.status === 'COMPLETED' ? 'bg-sky-400' : 'bg-neutral-500'
                  }`}></span>
                  <span>
                    {shiftState.status === 'WORKING' ? 'Clocked In' :
                     shiftState.status === 'ON_BREAK' ? `Break (${shiftState.currentBreakName || 'Meal'})` :
                     shiftState.status === 'COMPLETED' ? 'Shift Completed' : 'Not Clocked In'}
                  </span>
                </div>
              </div>

              {/* QUICK ROLE SWITCH PILL (Allows user to test both Employee & HR/Admin views!) */}
              <div className="hidden md:flex items-center bg-brand-dark border border-brand-border rounded-xl p-1 text-xs">
                <button
                  type="button"
                  onClick={() => handleRoleSwitch('employee')}
                  className={`px-2.5 py-1 rounded-lg font-semibold transition-all ${
                    currentUser.role === 'employee' 
                      ? 'bg-brand-amber text-neutral-950 font-bold shadow' 
                      : 'text-neutral-400 hover:text-white'
                  }`}
                >
                  👤 Employee
                </button>
                <button
                  type="button"
                  onClick={() => handleRoleSwitch('admin')}
                  className={`px-2.5 py-1 rounded-lg font-semibold transition-all ${
                    currentUser.role === 'admin' 
                      ? 'bg-brand-amber text-neutral-950 font-bold shadow' 
                      : 'text-neutral-400 hover:text-white'
                  }`}
                >
                  🛡️ HR / Admin
                </button>
              </div>

              {/* HR Verification Policy Settings Trigger Button (Mandatory Requirement) */}
              <button
                type="button"
                onClick={() => setIsHrSettingsModalOpen(true)}
                title="Configure Attendance Verification Policy (Selfie / Geo / QR Rules)"
                className="px-2.5 py-1.5 rounded-xl bg-brand-surface hover:bg-brand-card border border-brand-border text-brand-amber hover:text-white font-semibold text-xs flex items-center gap-1.5 transition-all shadow-sm cursor-pointer"
              >
                <Icon name="settings" className="w-3.5 h-3.5 text-brand-amber" />
                <span className="hidden sm:inline">HR Attendance Settings</span>
              </button>

              {/* User Profile Pill & Logout */}
              <div className="flex items-center gap-2 pl-1 border-l border-brand-border">
                <div className="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-amber to-amber-600 text-neutral-950 font-extrabold flex items-center justify-center text-xs shadow-md">
                  {currentUser.avatar}
                </div>
                <div className="hidden xl:block text-left leading-tight">
                  <div className="text-xs font-bold text-white truncate max-w-[120px]">{currentUser.name}</div>
                  <div className="text-[10px] text-brand-amber truncate max-w-[120px]">{currentUser.role === 'admin' ? 'HR Admin' : 'Employee'}</div>
                </div>
                <button 
                  onClick={() => {
                    setIsLoggedIn(false);
                    addToast('Logged Out', 'You have securely signed out.', 'info');
                  }}
                  title="Logout"
                  className="p-1.5 rounded-lg text-neutral-400 hover:text-rose-400 hover:bg-rose-500/10 transition-colors ml-1 cursor-pointer"
                >
                  <Icon name="log-out" className="w-4 h-4" />
                </button>
              </div>

            </div>
          </header>

          {/* ================================================================= */}
          {/* 2. BODY LAYOUT: SIDEBAR + MAIN CONTENT AREA                       */}
          {/* ================================================================= */}
          <div className="flex-1 flex overflow-hidden">
            
            {/* SIDEBAR NAVIGATION */}
            <aside className="w-64 bg-brand-surface border-r border-brand-border flex-shrink-0 flex flex-col justify-between hidden md:flex p-4">
              <div className="space-y-6">
                
                {/* Active HR Policy Banner Pill (Transparency for Employee) */}
                <div className="p-3 rounded-2xl bg-brand-dark/90 border border-brand-border text-[11px] space-y-1.5">
                  <div className="font-bold text-neutral-200 flex items-center justify-between">
                    <span className="flex items-center gap-1.5 text-brand-amber">
                      <Icon name="shield-check" className="w-3.5 h-3.5" />
                      <span>HR Attendance Rules</span>
                    </span>
                    <button onClick={() => setIsHrSettingsModalOpen(true)} className="text-[10px] text-brand-amber hover:underline cursor-pointer">Edit</button>
                  </div>
                  <div className="flex flex-col gap-1 text-[10px] text-neutral-400 font-mono">
                    <span className="flex items-center gap-1.5">
                      <span className={`w-1.5 h-1.5 rounded-full ${hrSettings.requireSelfie ? 'bg-emerald-400' : 'bg-neutral-600'}`}></span>
                      <span>Selfie Photo: <strong>{hrSettings.requireSelfie ? 'Mandatory' : 'Off'}</strong></span>
                    </span>
                    <span className="flex items-center gap-1.5">
                      <span className={`w-1.5 h-1.5 rounded-full ${hrSettings.requireGeo ? 'bg-emerald-400' : 'bg-neutral-600'}`}></span>
                      <span>Geofencing: <strong>{hrSettings.requireGeo ? `${hrSettings.allowedRadiusMeters}m Office Radius` : 'Disabled'}</strong></span>
                    </span>
                  </div>
                </div>

                {/* Primary Nav Links */}
                <nav className="space-y-1">
                  <div className="px-3 pb-1 text-[10px] font-bold text-neutral-500 uppercase tracking-wider">Employee Workspace</div>

                  <button
                    onClick={() => setActiveTab('dashboard')}
                    className={`w-full px-3 py-2.5 rounded-xl font-bold text-xs flex items-center gap-3 transition-all cursor-pointer ${
                      activeTab === 'dashboard' ? 'bg-brand-amber text-neutral-950 shadow-md' : 'text-neutral-300 hover:text-white hover:bg-brand-card'
                    }`}
                  >
                    <Icon name="clock" className="w-4 h-4" />
                    <span>Dashboard & Timer</span>
                  </button>

                  <button
                    onClick={() => setActiveTab('attendance')}
                    className={`w-full px-3 py-2.5 rounded-xl font-semibold text-xs flex items-center justify-between transition-all cursor-pointer ${
                      activeTab === 'attendance' ? 'bg-brand-amber text-neutral-950 font-bold shadow-md' : 'text-neutral-300 hover:text-white hover:bg-brand-card'
                    }`}
                  >
                    <div className="flex items-center gap-3">
                      <Icon name="calendar" className="w-4 h-4" />
                      <span>Attendance View</span>
                    </div>
                    <span className="px-1.5 py-0.5 rounded text-[10px] font-mono bg-brand-surface text-neutral-300">
                      {attendanceLogs.length}
                    </span>
                  </button>

                  <button
                    onClick={() => setActiveTab('leaves')}
                    className={`w-full px-3 py-2.5 rounded-xl font-semibold text-xs flex items-center justify-between transition-all cursor-pointer ${
                      activeTab === 'leaves' ? 'bg-brand-amber text-neutral-950 font-bold shadow-md' : 'text-neutral-300 hover:text-white hover:bg-brand-card'
                    }`}
                  >
                    <div className="flex items-center gap-3">
                      <Icon name="users" className="w-4 h-4" />
                      <span>Leave Management</span>
                    </div>
                    {leaveRequests.filter(r => r.status === 'Pending Review').length > 0 && (
                      <span className="px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500 text-neutral-950 animate-pulse">
                        {leaveRequests.filter(r => r.status === 'Pending Review').length}
                      </span>
                    )}
                  </button>

                  <button
                    onClick={() => setActiveTab('payslips')}
                    className={`w-full px-3 py-2.5 rounded-xl font-semibold text-xs flex items-center gap-3 transition-all cursor-pointer ${
                      activeTab === 'payslips' ? 'bg-brand-amber text-neutral-950 font-bold shadow-md' : 'text-neutral-300 hover:text-white hover:bg-brand-card'
                    }`}
                  >
                    <Icon name="file-text" className="w-4 h-4" />
                    <span>Salary Slip & PDF</span>
                  </button>

                  <div className="pt-4 px-3 pb-1 text-[10px] font-bold text-neutral-500 uppercase tracking-wider">Enterprise & Payroll</div>

                  <button
                    onClick={() => setActiveTab('payroll')}
                    className={`w-full px-3 py-2.5 rounded-xl font-semibold text-xs flex items-center gap-3 transition-all cursor-pointer ${
                      activeTab === 'payroll' ? 'bg-brand-amber text-neutral-950 font-bold shadow-md' : 'text-neutral-300 hover:text-white hover:bg-brand-card'
                    }`}
                  >
                    <Icon name="dollar-sign" className="w-4 h-4" />
                    <span>Payroll Disbursals</span>
                  </button>

                  <button
                    onClick={() => setActiveTab('xls-upload')}
                    className={`w-full px-3 py-2.5 rounded-xl font-semibold text-xs flex items-center gap-3 transition-all cursor-pointer ${
                      activeTab === 'xls-upload' ? 'bg-brand-amber text-neutral-950 font-bold shadow-md' : 'text-neutral-300 hover:text-white hover:bg-brand-card'
                    }`}
                  >
                    <Icon name="upload" className="w-4 h-4" />
                    <span>Attendance XLS Upload</span>
                  </button>
                </nav>
              </div>

              {/* Sidebar Footer info */}
              <div className="p-3 rounded-2xl bg-brand-dark border border-brand-border text-center space-y-1">
                <div className="text-[11px] font-bold text-white">SORA HR v2.4 (React)</div>
                <div className="text-[10px] text-neutral-500">ISO 27001 &bull; AES-256 Verified</div>
              </div>
            </aside>

            {/* MAIN WORKSPACE CONTENT CONTAINER */}
            <main className="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">
              
              {/* TAB 1: OVERVIEW & CLOCK DASHBOARD */}
              {activeTab === 'dashboard' && (
                <DashboardTab
                  currentUser={currentUser}
                  currentDateStr={currentDateStr}
                  shiftState={shiftState}
                  elapsedShiftSeconds={elapsedShiftSeconds}
                  elapsedBreakSeconds={elapsedBreakSeconds}
                  formatDuration={formatDuration}
                  hrSettings={hrSettings}
                  onClockIn={initiateClockIn}
                  onClockOut={handleClockOut}
                  onOpenBreakModal={() => setIsBreakModalOpen(true)}
                  onEndBreak={endBreak}
                  onOpenQrModal={() => setIsQrModalOpen(true)}
                  onOpenSettings={() => setIsHrSettingsModalOpen(true)}
                  attendanceLogs={attendanceLogs}
                  leaveQuotas={leaveQuotas}
                  onSwitchTab={setActiveTab}
                  onOpenApplyLeave={() => setIsApplyLeaveModalOpen(true)}
                  onPreviewSelfie={(url) => setPreviewSelfieUrl(url)}
                />
              )}

              {/* TAB 2: DETAILED ATTENDANCE VIEW */}
              {activeTab === 'attendance' && (
                <AttendanceViewTab
                  attendanceLogs={attendanceLogs}
                  hrSettings={hrSettings}
                  onPreviewSelfie={(url) => setPreviewSelfieUrl(url)}
                  onOpenXlsUpload={() => setActiveTab('xls-upload')}
                  onOpenSettings={() => setIsHrSettingsModalOpen(true)}
                />
              )}

              {/* TAB 3: PENDING LEAVE MANAGEMENT */}
              {activeTab === 'leaves' && (
                <LeaveManagementTab
                  currentUser={currentUser}
                  leaveQuotas={leaveQuotas}
                  leaveRequests={leaveRequests}
                  onOpenApplyModal={() => setIsApplyLeaveModalOpen(true)}
                  onApproveLeave={handleApproveLeave}
                  onRejectLeave={handleRejectLeave}
                />
              )}

              {/* TAB 4: SALARY SLIP VIEW & PDF */}
              {activeTab === 'payslips' && (
                <SalarySlipTab
                  currentUser={currentUser}
                  attendanceLogs={attendanceLogs}
                  onToast={addToast}
                />
              )}

              {/* TAB 5: PAYROLL OVERVIEW */}
              {activeTab === 'payroll' && (
                <PayrollTab
                  payrollData={payrollData}
                  onSelectEmployeePayslip={(emp) => {
                    setCurrentUser({
                      ...currentUser,
                      id: emp.empCode,
                      name: emp.name,
                      designation: emp.designation,
                      department: emp.dept
                    });
                    setActiveTab('payslips');
                    addToast('Payslip Loaded', `Loaded salary statement for ${emp.name}`, 'info');
                  }}
                  onDisburseAll={() => {
                    setPayrollData(prev => prev.map(p => ({ ...p, status: 'Disbursed' })));
                    addToast('Payroll Disbursal Complete', 'All monthly employee salaries marked Disbursed via ACH bank file.', 'success');
                  }}
                />
              )}

              {/* TAB 6: ATTENDANCE XLS UPLOAD & PARSING */}
              {activeTab === 'xls-upload' && (
                <XlsUploadTab
                  onImport={handleImportAttendanceXls}
                  hrSettings={hrSettings}
                />
              )}

            </main>
          </div>

          {/* ================================================================= */}
          {/* 3. MODALS & OVERLAYS                                              */}
          {/* ================================================================= */}

          {/* A. LIVE SELFIE CAMERA CAPTURE MODAL (The core HR Setting Requirement) */}
          {isSelfieModalOpen && (
            <SelfieCameraModal
              hrSettings={hrSettings}
              currentUser={currentUser}
              onCapture={(dataUrl) => {
                setIsSelfieModalOpen(false);
                finalizeClockIn(dataUrl);
              }}
              onClose={() => setIsSelfieModalOpen(false)}
            />
          )}

          {/* B. QR SCANNER MODAL */}
          {isQrModalOpen && (
            <QrScannerModal
              onSuccess={() => {
                setIsQrModalOpen(false);
                if (hrSettings.requireSelfie) {
                  setIsSelfieModalOpen(true);
                } else {
                  finalizeClockIn(null);
                }
              }}
              onClose={() => setIsQrModalOpen(false)}
            />
          )}

          {/* C. START BREAK SELECTOR MODAL */}
          {isBreakModalOpen && (
            <BreakSelectorModal
              onStartBreak={startBreak}
              onClose={() => setIsBreakModalOpen(false)}
            />
          )}

          {/* D. APPLY LEAVE MODAL */}
          {isApplyLeaveModalOpen && (
            <ApplyLeaveModal
              leaveQuotas={leaveQuotas}
              onSubmit={handleApplyLeave}
              onClose={() => setIsApplyLeaveModalOpen(false)}
            />
          )}

          {/* E. HR ATTENDANCE POLICY SETTINGS MODAL (Controlled by Admin/HR) */}
          {isHrSettingsModalOpen && (
            <HrSettingsModal
              hrSettings={hrSettings}
              onSave={(newSettings) => {
                setHrSettings(newSettings);
                setIsHrSettingsModalOpen(false);
                addToast('Policy Updated', 'HR Attendance & Verification Settings saved successfully!', 'success');
              }}
              onClose={() => setIsHrSettingsModalOpen(false)}
            />
          )}

          {/* F. ENLARGED SELFIE PHOTO VIEWER */}
          {previewSelfieUrl && (
            <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="bg-brand-surface border border-brand-border p-6 rounded-3xl max-w-sm w-full space-y-4 shadow-2xl">
                <div className="flex items-center justify-between">
                  <h3 className="text-sm font-bold text-white flex items-center gap-2">
                    <Icon name="camera" className="w-4 h-4 text-brand-amber" />
                    <span>Captured Attendance Selfie</span>
                  </h3>
                  <button onClick={() => setPreviewSelfieUrl(null)} className="text-neutral-400 hover:text-white p-1 cursor-pointer">
                    <Icon name="x-circle" className="w-5 h-5" />
                  </button>
                </div>
                <div className="rounded-2xl overflow-hidden border border-brand-border bg-black aspect-square flex items-center justify-center">
                  <img src={previewSelfieUrl} alt="Selfie Verification" className="w-full h-full object-cover" />
                </div>
                <div className="text-[11px] text-neutral-400 text-center font-mono">
                  AES-256 Geo &amp; Facial Timestamp Watermarked
                </div>
              </div>
            </div>
          )}

                    {/* ================================================================= */}
          {/* FIXED BOTTOM MOBILE NAVIGATION BAR                                */}
          {/* ================================================================= */}
          <nav className="fixed bottom-0 left-0 right-0 z-40 bg-[#121217]/95 backdrop-blur-xl border-t border-brand-border px-2 py-1.5 flex items-center justify-around shadow-2xl">
            <button
              onClick={() => setActiveTab('dashboard')}
              className={`flex flex-col items-center gap-1 py-1 px-2.5 rounded-xl transition-all cursor-pointer ${
                activeTab === 'dashboard' ? 'text-brand-amber font-bold' : 'text-neutral-400 hover:text-white'
              }`}
            >
              <div className={`p-1.5 rounded-xl transition-all ${activeTab === 'dashboard' ? 'bg-brand-amber/15 text-brand-amber scale-105' : ''}`}>
                <Icon name="clock" className="w-5 h-5" />
              </div>
              <span className="text-[10px] tracking-tight">Home</span>
            </button>

            <button
              onClick={() => setActiveTab('attendance')}
              className={`flex flex-col items-center gap-1 py-1 px-2.5 rounded-xl transition-all cursor-pointer ${
                activeTab === 'attendance' ? 'text-brand-amber font-bold' : 'text-neutral-400 hover:text-white'
              }`}
            >
              <div className={`p-1.5 rounded-xl transition-all ${activeTab === 'attendance' ? 'bg-brand-amber/15 text-brand-amber scale-105' : ''}`}>
                <Icon name="calendar" className="w-5 h-5" />
              </div>
              <span className="text-[10px] tracking-tight">Attendance</span>
            </button>

            <button
              onClick={() => setActiveTab('leaves')}
              className={`flex flex-col items-center gap-1 py-1 px-2.5 rounded-xl transition-all cursor-pointer ${
                activeTab === 'leaves' ? 'text-brand-amber font-bold' : 'text-neutral-400 hover:text-white'
              }`}
            >
              <div className={`p-1.5 rounded-xl transition-all ${activeTab === 'leaves' ? 'bg-brand-amber/15 text-brand-amber scale-105' : ''}`}>
                <Icon name="coffee" className="w-5 h-5" />
              </div>
              <span className="text-[10px] tracking-tight">Leaves</span>
            </button>

            <button
              onClick={() => setActiveTab('payslips')}
              className={`flex flex-col items-center gap-1 py-1 px-2.5 rounded-xl transition-all cursor-pointer ${
                activeTab === 'payslips' ? 'text-brand-amber font-bold' : 'text-neutral-400 hover:text-white'
              }`}
            >
              <div className={`p-1.5 rounded-xl transition-all ${activeTab === 'payslips' ? 'bg-brand-amber/15 text-brand-amber scale-105' : ''}`}>
                <Icon name="file-text" className="w-5 h-5" />
              </div>
              <span className="text-[10px] tracking-tight">Payslip</span>
            </button>

            {currentUser.role === 'admin' ? (
              <button
                onClick={() => setIsHrSettingsModalOpen(true)}
                className="flex flex-col items-center gap-1 py-1 px-2.5 text-neutral-400 hover:text-brand-amber transition-all cursor-pointer"
              >
                <div className="p-1.5 rounded-xl hover:bg-brand-amber/10">
                  <Icon name="settings" className="w-5 h-5" />
                </div>
                <span className="text-[10px] tracking-tight">HR Rules</span>
              </button>
            ) : (
              <button
                onClick={() => handleRoleSwitch('admin')}
                className="flex flex-col items-center gap-1 py-1 px-2.5 text-neutral-400 hover:text-brand-amber transition-all cursor-pointer"
              >
                <div className="p-1.5 rounded-xl hover:bg-brand-amber/10">
                  <Icon name="shield-check" className="w-5 h-5" />
                </div>
                <span className="text-[10px] tracking-tight">HR Mode</span>
              </button>
            )}
          </nav>

          {/* G. TOASTS NOTIFICATION LAYER */}
          <div className="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none">
            {toasts.map(t => (
              <div
                key={t.id}
                className={`p-4 rounded-2xl shadow-2xl border text-xs pointer-events-auto transition-all flex items-start gap-3 ${
                  t.type === 'success' ? 'bg-[#122319] border-emerald-500/40 text-emerald-100' :
                  t.type === 'info' ? 'bg-[#152331] border-sky-500/40 text-sky-100' :
                  'bg-[#2d1215] border-rose-500/40 text-rose-100'
                }`}
              >
                <div className="mt-0.5">
                  <Icon name={t.type === 'success' ? 'check-circle' : 'alert-circle'} className={`w-4 h-4 ${t.type === 'success' ? 'text-emerald-400' : 'text-sky-400'}`} />
                </div>
                <div className="flex-1">
                  <div className="font-bold text-white">{t.title}</div>
                  <div className="text-neutral-300 mt-0.5 leading-relaxed">{t.message}</div>
                </div>
              </div>
            ))}
          </div>

        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: LOGIN SCREEN (Split Layout matching SORA HR brand)
    // =========================================================================
        // =========================================================================
    // SUB-COMPONENT: SCREEN 1 -- WELCOME / ONBOARDING SCREEN
    // =========================================================================
    function WelcomeScreen({ onNext }) {
      const [activeSlide, setActiveSlide] = useState(0);

      const slides = [
        {
          badge: "Geofence & Biometrics",
          icon: "camera",
          title: "Selfie Attendance & GPS Punch",
          desc: "Clock in securely with AI facial selfie validation and automated BKC office geofence verification.",
          preview: "Geofence: Within BKC Campus (42m) âœ“"
