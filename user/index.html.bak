    // =========================================================================
    // SUB-COMPONENT: SCREEN 2 -- DEDICATED MOBILE LOGIN SCREEN
    // =========================================================================
    function LoginScreen({ onLogin, onBack }) {
      const [selectedRole, setSelectedRole] = useState('employee');
      const [email, setEmail] = useState('pooja.i@apextech.com');
      const [password, setPassword] = useState('sora123');
      const [showPassword, setShowPassword] = useState(false);
      const [rememberMe, setRememberMe] = useState(true);

      const handleSelectRole = (role) => {
        setSelectedRole(role);
        if (role === 'admin') {
          setEmail('aarav.s@apextech.com');
        } else {
          setEmail('pooja.i@apextech.com');
        }
      };

      const handleLoginSubmit = (e) => {
        if (e) e.preventDefault();
        if (selectedRole === 'admin') {
          onLogin(DEFAULT_USERS.admin);
        } else {
          onLogin(DEFAULT_USERS.employee);
        }
      };

      return (
        <div className="min-h-screen bg-[#09090c] text-white flex flex-col justify-between p-5 max-w-md mx-auto relative overflow-hidden">
          {/* Top Bar with Back Button */}
          <div className="relative z-10 pt-2 flex items-center justify-between">
            <button
              type="button"
              onClick={onBack}
              className="p-2 rounded-xl bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-white flex items-center gap-1.5 text-xs font-semibold cursor-pointer active:scale-95 transition-all"
            >
              <Icon name="arrow-left" className="w-4 h-4" />
              <span>Back</span>
            </button>

            <div className="flex items-center gap-2">
              <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span className="text-[11px] font-bold text-neutral-300">System Ready</span>
            </div>
          </div>

          {/* Center Form Container */}
          <div className="relative z-10 my-auto py-4 space-y-4">
            <div>
              <div className="w-10 h-10 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mb-2.5">
                <Icon name="log-in" className="w-5 h-5" />
              </div>
              <h2 className="text-2xl font-black text-white">Sign In</h2>
              <p className="text-xs text-neutral-400 mt-0.5">Select a role or enter your employee credentials</p>
            </div>

            {/* Quick 1-Tap Role Selector */}
            <div className="p-1 rounded-2xl bg-[#14141a] border border-neutral-800 grid grid-cols-2 gap-1">
              <button
                type="button"
                onClick={() => handleSelectRole('employee')}
                className={`py-2 px-3 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-all cursor-pointer ${
                  selectedRole === 'employee'
                    ? 'bg-gradient-to-r from-amber-500 to-amber-600 text-neutral-950 shadow-md'
                    : 'text-neutral-400 hover:text-white'
                }`}
              >
                <Icon name="user" className="w-3.5 h-3.5" />
                <span>Employee</span>
              </button>
              <button
                type="button"
                onClick={() => handleSelectRole('admin')}
                className={`py-2 px-3 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-all cursor-pointer ${
                  selectedRole === 'admin'
                    ? 'bg-gradient-to-r from-amber-500 to-amber-600 text-neutral-950 shadow-md'
                    : 'text-neutral-400 hover:text-white'
                }`}
              >
                <Icon name="shield-check" className="w-3.5 h-3.5" />
                <span>HR / Admin</span>
              </button>
            </div>

            {/* User Quick Info Card */}
            <div className="p-3 rounded-2xl bg-[#14141a] border border-amber-500/20 flex items-center gap-3">
              <div className="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 font-extrabold flex items-center justify-center text-xs">
                {selectedRole === 'admin' ? 'AS' : 'PI'}
              </div>
              <div className="flex-1 min-w-0">
                <div className="text-xs font-bold text-white truncate">
                  {selectedRole === 'admin' ? 'Aarav Sharma' : 'Pooja Iyer'}
                </div>
                <div className="text-[10px] text-amber-400 truncate">
                  {selectedRole === 'admin' ? 'Head of People Operations' : 'Senior UX Designer'}
                </div>
              </div>
              <span className="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 text-[9px] font-bold border border-emerald-500/20">
                1-Click Ready
              </span>
            </div>

            {/* Form */}
            <form onSubmit={handleLoginSubmit} className="space-y-3">
              <div>
                <label className="block text-[10px] font-bold text-neutral-400 mb-1 uppercase tracking-wider">
                  Work Email / Employee Code
                </label>
                <div className="relative">
                  <Icon name="mail" className="w-4 h-4 text-neutral-500 absolute left-3 top-1/2 -translate-y-1/2" />
                  <input
                    type="text"
                    value={email}
                    onChange={(e) => setEmail(e.target.value)}
                    className="w-full pl-9 pr-3 py-2.5 rounded-xl bg-[#14141a] border border-neutral-800 focus:border-amber-500 text-white text-xs outline-none transition-all"
                    placeholder="name@apextech.com"
                    required
                  />
                </div>
              </div>

              <div>
                <label className="block text-[10px] font-bold text-neutral-400 mb-1 uppercase tracking-wider">
                  Password
                </label>
                <div className="relative">
                  <Icon name="lock" className="w-4 h-4 text-neutral-500 absolute left-3 top-1/2 -translate-y-1/2" />
                  <input
                    type={showPassword ? "text" : "password"}
                    value={password}
                    onChange={(e) => setPassword(e.target.value)}
                    className="w-full pl-9 pr-9 py-2.5 rounded-xl bg-[#14141a] border border-neutral-800 focus:border-amber-500 text-white text-xs outline-none transition-all"
                    placeholder="Enter password"
                    required
                  />
                  <button
                    type="button"
                    onClick={() => setShowPassword(!showPassword)}
                    className="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-500 hover:text-white"
                  >
                    <Icon name={showPassword ? "eye-off" : "eye"} className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>

              <div className="flex items-center justify-between text-xs pt-0.5">
                <label className="flex items-center gap-1.5 cursor-pointer text-neutral-400 hover:text-white text-[11px]">
                  <input
                    type="checkbox"
                    checked={rememberMe}
                    onChange={(e) => setRememberMe(e.target.checked)}
                    className="rounded accent-amber-500"
                  />
                  <span>Remember me</span>
                </label>
                <span className="text-amber-400 text-[11px]">Demo: sora123</span>
              </div>

              <button
                type="submit"
                className="w-full mt-1.5 py-3.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-neutral-950 font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 active:scale-[0.98] transition-all cursor-pointer"
              >
                <Icon name="shield-check" className="w-4 h-4 text-neutral-950" />
                <span>Sign In to SORA HR</span>
              </button>
            </form>
          </div>

          {/* Footer */}
          <div className="relative z-10 text-center text-[10px] text-neutral-500 pb-1">
            256-bit Encrypted Session â€¢ Apex Global Technologies
          </div>
        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: TAB 1 -- DASHBOARD
    // =========================================================================
    function DashboardTab({
      currentUser,
      currentDateStr,
      shiftState,
      elapsedShiftSeconds,
      elapsedBreakSeconds,
      formatDuration,
      hrSettings,
      onClockIn,
      onClockOut,
      onOpenBreakModal,
      onEndBreak,
      onOpenQrModal,
      onOpenSettings,
      attendanceLogs,
      leaveQuotas,
      onSwitchTab,
      onOpenApplyLeave,
      onPreviewSelfie
    }) {
      return (
        <div className="space-y-6">
          
          {/* Top Banner Greeting */}
          <div className="p-6 rounded-3xl bg-gradient-to-r from-brand-surface via-brand-dark to-brand-surface border border-brand-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div className="text-xs font-semibold text-brand-amber flex items-center gap-1.5 mb-1">
                <span>Apex Global Technologies</span>
                <span>&bull;</span>
                <span>{currentDateStr}</span>
              </div>
              <h2 className="text-xl sm:text-2xl font-extrabold text-white">
                Welcome back, {currentUser.name}! 👋
              </h2>
              <p className="text-xs text-neutral-400 mt-1">
                {currentUser.designation} &bull; {currentUser.department}
              </p>
            </div>

            {/* Verification Rule Status Badge */}
            <div className="flex items-center gap-2 bg-brand-card/80 p-3 rounded-2xl border border-brand-border">
              <div className="w-10 h-10 rounded-xl bg-brand-amber/15 border border-brand-amber/30 text-brand-amber flex items-center justify-center">
                <Icon name="shield-check" className="w-5 h-5" />
              </div>
              <div className="text-left">
                <div className="text-[10px] text-neutral-400 uppercase font-bold">HR Punch Policy</div>
                <div className="text-xs font-bold text-white flex items-center gap-1.5">
                  <span className={`w-2 h-2 rounded-full ${hrSettings.requireSelfie ? 'bg-emerald-400' : 'bg-neutral-500'}`}></span>
                  <span>{hrSettings.requireSelfie ? '📸 Selfie Required' : 'Touchless Direct'}</span>
                  <span>&bull;</span>
                  <span>{hrSettings.requireGeo ? '📍 Geofenced' : 'Open'}</span>
                </div>
              </div>
            </div>
          </div>

          {/* Core Interactive Shift Attendance Station */}
          <div className="p-6 sm:p-8 rounded-3xl bg-brand-surface border border-brand-border shadow-xl space-y-6 relative overflow-hidden">
            <div className="absolute -right-20 -top-20 w-64 h-64 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>

            <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-brand-border">
              <div>
                <span className="text-[10px] font-bold text-brand-amber uppercase tracking-wider">Live Shift &amp; Punch Desk</span>
                <h3 className="text-lg font-bold text-white flex items-center gap-2 mt-0.5">
                  <Icon name="clock" className="w-5 h-5 text-brand-amber" />
                  <span>Real-Time Shift Attendance Controller</span>
                </h3>
              </div>

              {/* Quick Scan & Settings Actions */}
              <div className="flex items-center gap-2">
                <button
                  type="button"
                  onClick={onOpenQrModal}
                  className="px-3.5 py-2 rounded-xl bg-brand-card hover:bg-brand-dark border border-brand-border text-neutral-200 hover:text-white text-xs font-semibold flex items-center gap-2 transition-all shadow-sm cursor-pointer"
                >
                  <Icon name="qr-code" className="w-4 h-4 text-brand-amber" />
                  <span>Scan Office QR</span>
                </button>

                <button
                  type="button"
                  onClick={onOpenSettings}
                  className="px-3.5 py-2 rounded-xl bg-brand-dark hover:bg-brand-surface border border-brand-border text-brand-amber hover:text-white text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer"
                >
                  <Icon name="settings" className="w-3.5 h-3.5" />
                  <span>Rules</span>
                </button>
              </div>
            </div>

            {/* Digital Stopwatch Tickers */}
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
              
              {/* Box 1: Productive Hours */}
              <div className="p-5 rounded-2xl bg-brand-dark border border-brand-border flex flex-col justify-between">
                <div className="text-[11px] text-neutral-400 font-semibold uppercase flex items-center justify-between">
                  <span>Productive Work Hours</span>
                  <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                </div>
                <div className="text-3xl sm:text-4xl font-extrabold font-mono text-emerald-400 mt-2">
                  {shiftState.status === 'WORKING' ? formatDuration(elapsedShiftSeconds) :
                   shiftState.status === 'COMPLETED' ? (attendanceLogs[0]?.hours || '08h 15m') : '00:00:00'}
                </div>
                <div className="text-[10px] text-neutral-500 font-mono mt-1">
                  Target Shift: 09h 00m &bull; General Shift
                </div>
              </div>

              {/* Box 2: Total Break Time */}
              <div className="p-5 rounded-2xl bg-brand-dark border border-brand-border flex flex-col justify-between">
                <div className="text-[11px] text-neutral-400 font-semibold uppercase flex items-center justify-between">
                  <span>Break Stopwatch</span>
                  <Icon name="coffee" className="w-4 h-4 text-amber-400" />
                </div>
                <div className="text-3xl sm:text-4xl font-extrabold font-mono text-amber-300 mt-2">
                  {shiftState.status === 'ON_BREAK' ? formatDuration(elapsedBreakSeconds) :
                   formatDuration(shiftState.totalBreakSeconds)}
                </div>
                <div className="text-[10px] text-neutral-500 font-mono mt-1">
                  {shiftState.status === 'ON_BREAK' ? `Currently on: ${shiftState.currentBreakName}` : 'Permitted lunch/tea: 60m'}
                </div>
              </div>

              {/* Box 3: Office Distance & Geofence Status */}
              <div className="p-5 rounded-2xl bg-brand-dark border border-brand-border flex flex-col justify-between">
                <div className="text-[11px] text-neutral-400 font-semibold uppercase flex items-center justify-between">
                  <span>Geofence Proximity</span>
                  <Icon name="map-pin" className="w-4 h-4 text-brand-amber" />
                </div>
                <div className="text-2xl font-extrabold text-white mt-2 flex items-center gap-2">
                  <span className="text-brand-amber">BKC Office</span>
                </div>
                <div className="text-[11px] text-emerald-400 font-mono mt-1 flex items-center gap-1.5">
                  <span className="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span>Within 28m of 100m Office Radius</span>
                </div>
              </div>

            </div>

            {/* THREE PRIMARY ACTION BUTTONS (Clock In, Start Break, Clock Out) */}
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              
              {/* BUTTON 1: CLOCK IN */}
              <button
                type="button"
                onClick={onClockIn}
                disabled={shiftState.status === 'WORKING' || shiftState.status === 'ON_BREAK'}
                className={`py-4 px-6 rounded-2xl font-black text-sm flex items-center justify-center gap-2.5 transition-all shadow-xl ${
                  shiftState.status === 'NOT_CLOCKED_IN' || shiftState.status === 'COMPLETED'
                    ? 'bg-emerald-500 hover:bg-emerald-400 text-neutral-950 shadow-emerald-500/20 active:scale-95 cursor-pointer'
                    : 'bg-brand-card opacity-40 cursor-not-allowed border border-brand-border text-neutral-400'
                }`}
              >
                <Icon name="log-in" className="w-5 h-5" />
                <span>Clock In for Today</span>
              </button>

              {/* BUTTON 2: BREAK (Start / Resume) */}
              {shiftState.status === 'ON_BREAK' ? (
                <button
                  type="button"
                  onClick={onEndBreak}
                  className="py-4 px-6 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-black text-sm flex items-center justify-center gap-2.5 transition-all shadow-xl shadow-emerald-500/20 active:scale-95 cursor-pointer animate-pulse"
                >
                  <Icon name="coffee" className="w-5 h-5 text-neutral-950" />
                  <span>Resume Work / End Break</span>
                </button>
              ) : (
                <button
                  type="button"
                  onClick={onOpenBreakModal}
                  disabled={shiftState.status !== 'WORKING'}
                  className={`py-4 px-6 rounded-2xl font-bold text-sm flex items-center justify-center gap-2.5 transition-all ${
                    shiftState.status === 'WORKING'
                      ? 'bg-brand-card hover:bg-brand-surface border border-brand-amber/40 text-amber-300 active:scale-95 cursor-pointer shadow-md'
                      : 'bg-brand-card opacity-40 cursor-not-allowed border border-brand-border text-neutral-400'
                  }`}
                >
                  <Icon name="coffee" className="w-5 h-5 text-amber-400" />
                  <span>Take a Break (Meal/Tea)</span>
                </button>
              )}

              {/* BUTTON 3: CLOCK OUT */}
              <button
                type="button"
                onClick={onClockOut}
                disabled={shiftState.status !== 'WORKING'}
                className={`py-4 px-6 rounded-2xl font-bold text-sm flex items-center justify-center gap-2.5 transition-all ${
                  shiftState.status === 'WORKING'
                    ? 'bg-rose-500 hover:bg-rose-400 text-white shadow-xl shadow-rose-500/20 active:scale-95 cursor-pointer'
                    : 'bg-brand-card opacity-40 cursor-not-allowed border border-brand-border text-neutral-400'
                }`}
              >
                <Icon name="log-out" className="w-5 h-5" />
                <span>Clock Out &amp; End Shift</span>
              </button>

            </div>

            {/* Today Punch Timeline Strip */}
            <div className="p-4 rounded-2xl bg-brand-dark/70 border border-brand-border grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
              <div>
                <span className="text-neutral-500 text-[10px] uppercase font-bold block">First Clock-In</span>
                <strong className="text-white font-mono text-sm">
                  {shiftState.clockInTime ? new Date(shiftState.clockInTime).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true }) : '--:--'}
                </strong>
              </div>
              <div>
                <span className="text-neutral-500 text-[10px] uppercase font-bold block">Breaks Logged</span>
                <strong className="text-amber-300 font-mono text-sm">
                  {Math.round(shiftState.totalBreakSeconds / 60)} min
                </strong>
              </div>
              <div>
                <span className="text-neutral-500 text-[10px] uppercase font-bold block">Clock-Out</span>
                <strong className="text-white font-mono text-sm">
                  {shiftState.clockOutTime ? new Date(shiftState.clockOutTime).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true }) : '--:--'}
                </strong>
              </div>
              <div>
                <span className="text-neutral-500 text-[10px] uppercase font-bold block">Punches Today</span>
                <strong className="text-emerald-400 font-mono text-sm">
                  {shiftState.todayPunches} Logged
                </strong>
              </div>
            </div>

          </div>

          {/* Leave Balances Quick Grid */}
          <div className="space-y-3">
            <div className="flex items-center justify-between">
              <h3 className="text-sm font-bold text-white flex items-center gap-2">
                <Icon name="users" className="w-4 h-4 text-brand-amber" />
                <span>My Leave Quota Balances</span>
              </h3>
              <button
                type="button"
                onClick={onOpenApplyLeave}
                className="text-xs text-brand-amber hover:underline font-semibold flex items-center gap-1 cursor-pointer"
              >
                <span>+ Apply for Leave</span>
                <Icon name="arrow-right" className="w-3.5 h-3.5" />
              </button>
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
              {Object.entries(leaveQuotas).map(([key, item]) => (
                <div key={key} className="p-4 rounded-2xl bg-brand-surface border border-brand-border space-y-1.5 shadow-sm">
                  <div className="flex items-center justify-between text-[11px] font-semibold text-neutral-400">
                    <span>{key}</span>
                    <span className="font-mono text-xs text-brand-amber font-bold">{item.remaining} Left</span>
                  </div>
                  <div className="text-xl font-bold text-white font-mono">{item.remaining} <span className="text-xs font-normal text-neutral-400">/ {item.quota}d</span></div>
                  <div className="text-[10px] text-neutral-500 truncate">{item.name}</div>
                </div>
              ))}
            </div>
          </div>

          {/* Recent Attendance Logs Table */}
          <div className="p-6 rounded-3xl bg-brand-surface border border-brand-border space-y-4">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-sm font-bold text-white flex items-center gap-2">
                  <Icon name="calendar" className="w-4 h-4 text-brand-amber" />
                  <span>Recent Daily Attendance History</span>
                </h3>
                <p className="text-[11px] text-neutral-400">Last 5 recorded shifts with Geofence &amp; Selfie status.</p>
              </div>
              <button
                type="button"
                onClick={() => onSwitchTab('attendance')}
                className="text-xs text-brand-amber hover:underline font-semibold cursor-pointer"
              >
                View Full Month &rarr;
              </button>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full text-left text-xs border-collapse">
                <thead>
                  <tr className="border-b border-brand-border text-neutral-400 font-mono text-[11px]">
                    <th className="py-2.5 px-3">Date</th>
                    <th className="py-2.5 px-3">In Time</th>
                    <th className="py-2.5 px-3">Out Time</th>
                    <th className="py-2.5 px-3">Break</th>
                    <th className="py-2.5 px-3">Net Hours</th>
                    <th className="py-2.5 px-3">Selfie Photo</th>
                    <th className="py-2.5 px-3">Status</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-brand-border">
                  {attendanceLogs.slice(0, 5).map(log => (
                    <tr key={log.id} className="hover:bg-brand-card/40 transition-colors">
                      <td className="py-3 px-3 font-semibold text-white">{log.displayDate}</td>
                      <td className="py-3 px-3 font-mono text-emerald-400 font-bold">{log.inTime}</td>
                      <td className="py-3 px-3 font-mono text-neutral-300">{log.outTime}</td>
                      <td className="py-3 px-3 font-mono text-amber-300">{log.breakMinutes}m</td>
                      <td className="py-3 px-3 font-mono font-bold text-white">{log.hours}</td>
                      <td className="py-3 px-3">
                        {log.selfieUrl ? (
                          <button
                            type="button"
                            onClick={() => onPreviewSelfie(log.selfieUrl)}
                            className="flex items-center gap-1.5 px-2 py-1 rounded-lg bg-brand-dark hover:bg-brand-surface border border-brand-border text-brand-amber text-[10px] font-semibold transition-all cursor-pointer"
                          >
                            <img src={log.selfieUrl} alt="Selfie" className="w-4 h-4 rounded-full object-cover" />
                            <span>Preview</span>
                          </button>
                        ) : (
                          <span className="text-[10px] text-neutral-500 font-mono">No Photo</span>
                        )}
                      </td>
                      <td className="py-3 px-3">
                        <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold border ${
                          log.status === 'Present' ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30' :
                          log.status === 'Late' ? 'bg-amber-500/15 text-amber-300 border-amber-500/30' :
                          'bg-purple-500/15 text-purple-300 border-purple-500/30'
                        }`}>
                          {log.status}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: TAB 2 — ATTENDANCE VIEW (Calendar & Full Register)
    // =========================================================================
    function AttendanceViewTab({ attendanceLogs, hrSettings, onPreviewSelfie, onOpenXlsUpload, onOpenSettings }) {
      const [filterMonth, setFilterMonth] = useState('2026-11');

      // 30 Days Monthly Calendar Grid Simulation
      const calendarDays = useMemo(() => {
        const days = [];
        for (let i = 1; i <= 30; i++) {
          const dayStr = String(i).padStart(2, '0');
          const dateKey = `2026-11-${dayStr}`;
          const isWeekend = (i % 7 === 1 || i % 7 === 0);
          const log = attendanceLogs.find(l => l.date === dateKey);

          let status = 'Not Logged';
          if (isWeekend) status = 'Weekend';
          else if (log) status = log.status;
          else if (i < 8) status = 'Present';

          days.push({ day: i, dateKey, status, log });
        }
        return days;
      }, [attendanceLogs]);

      return (
        <div className="space-y-6">
          
          {/* Header Controls */}
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 className="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
                <Icon name="calendar" className="w-6 h-6 text-brand-amber" />
                <span>Monthly Attendance Register &amp; Calendar</span>
              </h2>
              <p className="text-xs text-neutral-400 mt-0.5">
                Full 30-day view with Geotag coordinates, shift durations, and selfie photo proof.
              </p>
            </div>

            <div className="flex items-center gap-2.5">
              <button
                type="button"
                onClick={onOpenXlsUpload}
                className="px-3.5 py-2 rounded-xl bg-brand-surface hover:bg-brand-card border border-brand-border text-white text-xs font-semibold flex items-center gap-2 transition-all shadow-sm cursor-pointer"
              >
                <Icon name="upload" className="w-3.5 h-3.5 text-brand-amber" />
                <span>Upload Attendance XLS</span>
              </button>

              <button
                type="button"
                onClick={onOpenSettings}
                className="px-3.5 py-2 rounded-xl bg-brand-dark hover:bg-brand-surface border border-brand-border text-brand-amber text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer"
              >
                <Icon name="settings" className="w-3.5 h-3.5" />
                <span>Settings</span>
              </button>
            </div>
          </div>

          {/* Monthly KPI Stats Strip */}
          <div className="grid grid-cols-2 sm:grid-cols-5 gap-3">
            <div className="p-4 rounded-2xl bg-brand-surface border border-brand-border">
              <span className="text-[10px] text-neutral-400 font-semibold uppercase block">Working Days</span>
              <div className="text-2xl font-bold font-mono text-white mt-1">22</div>
              <span className="text-[9px] text-neutral-500">Excl. 8 Weekends</span>
            </div>
            <div className="p-4 rounded-2xl bg-brand-surface border border-brand-border">
              <span className="text-[10px] text-neutral-400 font-semibold uppercase block">Days Present</span>
              <div className="text-2xl font-bold font-mono text-emerald-400 mt-1">6 / 6</div>
              <span className="text-[9px] text-emerald-400">100% On-time</span>
            </div>
            <div className="p-4 rounded-2xl bg-brand-surface border border-brand-border">
              <span className="text-[10px] text-neutral-400 font-semibold uppercase block">Late Marks</span>
              <div className="text-2xl font-bold font-mono text-amber-400 mt-1">1</div>
              <span className="text-[9px] text-neutral-500">Within grace limit (3)</span>
            </div>
            <div className="p-4 rounded-2xl bg-brand-surface border border-brand-border">
              <span className="text-[10px] text-neutral-400 font-semibold uppercase block">Avg Shift</span>
              <div className="text-2xl font-bold font-mono text-white mt-1">08h 22m</div>
              <span className="text-[9px] text-neutral-500">Target: 08h 00m</span>
            </div>
            <div className="p-4 rounded-2xl bg-brand-surface border border-brand-border">
              <span className="text-[10px] text-neutral-400 font-semibold uppercase block">Selfie Verified</span>
              <div className="text-2xl font-bold font-mono text-brand-amber mt-1">
                {attendanceLogs.filter(l => l.hasSelfie).length}
              </div>
              <span className="text-[9px] text-neutral-500">Facial stamp audit</span>
            </div>
          </div>

          {/* Interactive 30-Day Monthly Calendar Grid */}
          <div className="p-6 rounded-3xl bg-brand-surface border border-brand-border space-y-4">
            <div className="flex items-center justify-between">
              <h3 className="text-sm font-bold text-white flex items-center gap-2">
                <Icon name="calendar" className="w-4 h-4 text-brand-amber" />
                <span>November 2026 — Shift Calendar</span>
              </h3>
              <div className="flex items-center gap-3 text-[10px] font-semibold text-neutral-400">
                <span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-emerald-400"></span> Present</span>
                <span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-amber-400"></span> Late</span>
                <span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-purple-400"></span> Half Day</span>
                <span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-neutral-600"></span> Weekend</span>
              </div>
            </div>

            <div className="grid grid-cols-7 gap-2 text-center text-xs">
              {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(d => (
                <div key={d} className="py-1 text-[11px] font-bold text-neutral-500 uppercase">{d}</div>
              ))}
              {calendarDays.map(item => {
                const isPresent = item.status === 'Present';
                const isLate = item.status === 'Late';
                const isHalf = item.status === 'Half Day';
                const isWeekend = item.status === 'Weekend';

                return (
                  <div
                    key={item.day}
                    className={`p-2.5 rounded-xl border text-left transition-all ${
                      isPresent ? 'bg-emerald-500/10 border-emerald-500/30 text-white' :
                      isLate ? 'bg-amber-500/10 border-amber-500/30 text-white' :
                      isHalf ? 'bg-purple-500/10 border-purple-500/30 text-white' :
                      isWeekend ? 'bg-brand-dark/40 border-brand-border/40 text-neutral-600' :
                      'bg-brand-dark border-brand-border text-neutral-400'
                    }`}
                  >
                    <div className="flex items-center justify-between">
                      <span className="font-mono font-bold text-xs">{item.day}</span>
                      {item.log?.hasSelfie && (
                        <Icon name="camera" className="w-3 h-3 text-brand-amber" title="Selfie Verified" />
                      )}
                    </div>
                    <div className="mt-1 text-[9px] font-semibold truncate">
                      {item.status}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Full Detailed Shift Logs Table */}
          <div className="p-6 rounded-3xl bg-brand-surface border border-brand-border space-y-4">
            <div className="flex items-center justify-between">
              <h3 className="text-sm font-bold text-white flex items-center gap-2">
                <Icon name="file-text" className="w-4 h-4 text-brand-amber" />
                <span>All Shift Records with Geo-Coordinates &amp; Watermarks</span>
              </h3>
              <span className="text-xs font-mono text-brand-amber">{attendanceLogs.length} Records</span>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full text-left text-xs border-collapse">
                <thead>
                  <tr className="border-b border-brand-border text-neutral-400 font-mono text-[11px]">
                    <th className="py-3 px-3">Date</th>
                    <th className="py-3 px-3">In Time</th>
                    <th className="py-3 px-3">Out Time</th>
                    <th className="py-3 px-3">Break</th>
                    <th className="py-3 px-3">Work Hours</th>
                    <th className="py-3 px-3">Geotag Location</th>
                    <th className="py-3 px-3">Selfie Photo</th>
                    <th className="py-3 px-3">Verification</th>
                    <th className="py-3 px-3">Status</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-brand-border">
                  {attendanceLogs.map(log => (
                    <tr key={log.id} className="hover:bg-brand-card/40 transition-colors">
                      <td className="py-3 px-3 font-semibold text-white">{log.displayDate}</td>
                      <td className="py-3 px-3 font-mono text-emerald-400 font-bold">{log.inTime}</td>
                      <td className="py-3 px-3 font-mono text-neutral-300">{log.outTime}</td>
                      <td className="py-3 px-3 font-mono text-amber-300">{log.breakMinutes}m</td>
                      <td className="py-3 px-3 font-mono font-bold text-white">{log.hours}</td>
                      <td className="py-3 px-3 text-neutral-400 font-mono text-[11px] truncate max-w-[180px]">
                        {log.location}
                      </td>
                      <td className="py-3 px-3">
                        {log.selfieUrl ? (
                          <button
                            type="button"
                            onClick={() => onPreviewSelfie(log.selfieUrl)}
                            className="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-brand-dark hover:bg-brand-surface border border-brand-border text-brand-amber text-[10px] font-semibold transition-all cursor-pointer"
                          >
                            <img src={log.selfieUrl} alt="Selfie" className="w-5 h-5 rounded-full object-cover" />
                            <span>View Photo</span>
                          </button>
                        ) : (
                          <span className="text-[10px] text-neutral-500 font-mono">No Image</span>
                        )}
                      </td>
                      <td className="py-3 px-3">
                        <span className="text-[10px] font-mono text-neutral-400 bg-brand-dark px-2 py-0.5 rounded border border-brand-border">
                          {log.method}
                        </span>
                      </td>
                      <td className="py-3 px-3">
                        <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${
                          log.status === 'Present' ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30' :
                          log.status === 'Late' ? 'bg-amber-500/15 text-amber-300 border-amber-500/30' :
                          'bg-purple-500/15 text-purple-300 border-purple-500/30'
                        }`}>
                          {log.status}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: TAB 3 — LEAVE MANAGEMENT (Pending Requests & Approvals)
    // =========================================================================
    function LeaveManagementTab({ currentUser, leaveQuotas, leaveRequests, onOpenApplyModal, onApproveLeave, onRejectLeave }) {
      return (
        <div className="space-y-6">
          
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 className="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
                <Icon name="users" className="w-6 h-6 text-brand-amber" />
                <span>Pending Leave Management &amp; Approvals</span>
              </h2>
              <p className="text-xs text-neutral-400 mt-0.5">
                Apply for leaves, view balances, and approve pending requests with HR privileges.
              </p>
            </div>

            <button
              type="button"
              onClick={onOpenApplyModal}
              className="px-4 py-2.5 rounded-xl bg-brand-amber hover:bg-brand-amberLight text-neutral-950 font-bold text-xs shadow-lg shadow-brand-amber/20 flex items-center gap-2 transition-all cursor-pointer"
            >
              <Icon name="plus" className="w-4 h-4" />
              <span>Apply for New Leave</span>
            </button>
          </div>

          {/* Leave Quotas Cards */}
          <div className="grid grid-cols-1 sm:grid-cols-4 gap-4">
            {Object.entries(leaveQuotas).map(([key, item]) => (
              <div key={key} className="p-5 rounded-2xl bg-brand-surface border border-brand-border space-y-2">
                <div className="flex items-center justify-between text-xs text-neutral-400 font-semibold">
                  <span>{item.name}</span>
                  <span className="font-mono text-brand-amber font-bold">{item.remaining} Left</span>
                </div>
                <div className="text-3xl font-extrabold text-white font-mono">
                  {item.remaining} <span className="text-sm font-normal text-neutral-500">/ {item.quota} Days</span>
                </div>
                <div className="w-full bg-brand-dark rounded-full h-1.5 overflow-hidden">
                  <div 
                    className="bg-brand-amber h-full rounded-full transition-all" 
                    style={{ width: `${(item.remaining / item.quota) * 100}%` }}
                  ></div>
                </div>
                <div className="text-[10px] text-neutral-500 flex justify-between font-mono pt-1">
                  <span>Used: {item.used}d</span>
                  <span>Annual Quota: {item.quota}d</span>
                </div>
              </div>
            ))}
          </div>

          {/* HR / MANAGER LEAVE APPROVALS SECTION (Visible to HR or for demonstration!) */}
          <div className="p-6 rounded-3xl bg-brand-surface border border-brand-border space-y-4">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-sm font-bold text-white flex items-center gap-2">
                  <Icon name="shield-check" className="w-4 h-4 text-emerald-400" />
                  <span>Pending Leave Requests Requiring Approval</span>
                </h3>
                <p className="text-[11px] text-neutral-400">
                  {currentUser.role === 'admin' ? 'As HR Admin, review and authorize team leave applications.' : 'Team Lead / HR Approval Desk.'}
                </p>
              </div>
              <span className="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30">
                {leaveRequests.filter(r => r.status === 'Pending Review').length} Pending
              </span>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full text-left text-xs border-collapse">
                <thead>
                  <tr className="border-b border-brand-border text-neutral-400 font-mono text-[11px]">
                    <th className="py-3 px-3">Req ID</th>
                    <th className="py-3 px-3">Employee</th>
                    <th className="py-3 px-3">Leave Type</th>
                    <th className="py-3 px-3">Dates &amp; Duration</th>
                    <th className="py-3 px-3">Reason</th>
                    <th className="py-3 px-3">Status</th>
                    <th className="py-3 px-3 text-right">HR Action</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-brand-border">
                  {leaveRequests.map(req => (
                    <tr key={req.id} className="hover:bg-brand-card/40 transition-colors">
                      <td className="py-3 px-3 font-mono font-bold text-brand-amber">{req.id}</td>
                      <td className="py-3 px-3">
                        <div className="font-bold text-white">{req.empName}</div>
                        <div className="text-[10px] text-neutral-400 font-mono">{req.empCode}</div>
                      </td>
                      <td className="py-3 px-3 font-semibold text-neutral-200">{req.type}</td>
                      <td className="py-3 px-3 font-mono text-neutral-300">
                        {req.dates} ({req.days} day{req.days > 1 ? 's' : ''})
                      </td>
                      <td className="py-3 px-3 text-neutral-400 italic max-w-xs truncate">{req.reason}</td>
                      <td className="py-3 px-3">
                        <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${
                          req.status === 'Approved' ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30' :
                          req.status === 'Pending Review' ? 'bg-amber-500/15 text-amber-300 border-amber-500/30 animate-pulse' :
                          'bg-rose-500/15 text-rose-400 border-rose-500/30'
                        }`}>
                          {req.status}
                        </span>
                      </td>
                      <td className="py-3 px-3 text-right">
                        {req.status === 'Pending Review' ? (
                          <div className="flex items-center justify-end gap-1.5">
                            <button
                              type="button"
                              onClick={() => onApproveLeave(req.id)}
                              className="px-2.5 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500 hover:text-neutral-950 text-emerald-400 font-bold text-[11px] border border-emerald-500/40 transition-all cursor-pointer"
                            >
                              Approve
                            </button>
                            <button
                              type="button"
                              onClick={() => onRejectLeave(req.id)}
                              className="px-2.5 py-1 rounded-lg bg-rose-500/20 hover:bg-rose-500 hover:text-white text-rose-400 font-bold text-[11px] border border-rose-500/40 transition-all cursor-pointer"
                            >
                              Reject
                            </button>
                          </div>
                        ) : (
                          <span className="text-[11px] text-neutral-500 font-mono">Resolved</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: TAB 4 — SALARY SLIP (Interactive & Printable PDF)
    // =========================================================================
    function SalarySlipTab({ currentUser, attendanceLogs, onToast }) {
      const [selectedMonth, setSelectedMonth] = useState('October 2026');

      // Salary details
      const basicPay = 42000;
      const hra = 21000;
      const specialAllowance = 12500;
      const conveyance = 3500;
      const performanceBonus = 5000;
      const grossEarnings = basicPay + hra + specialAllowance + conveyance + performanceBonus; // 84000

      const pf = 5040;
      const profTax = 200;
      const tds = 4200;
      const lop = 2710;
      const totalDeductions = pf + profTax + tds + lop; // 12150
      const netSalary = grossEarnings - totalDeductions; // 71850

      const handleDownloadPdf = () => {
        const element = document.getElementById('printable-payslip-area');
        if (!element || !window.html2pdf) {
          window.print();
          return;
        }

        const opt = {
          margin: 0.3,
          filename: `SoraHR_SalarySlip_${currentUser.id}_Oct2026.pdf`,
          image: { type: 'jpeg', quality: 0.98 },
          html2canvas: { scale: 2, useCORS: true },
          jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
        };

        window.html2pdf().set(opt).from(element).save();
        onToast('Payslip Exported', 'Downloading high-resolution salary slip PDF.', 'success');
      };

      return (
        <div className="space-y-6">
          
          {/* Header Controls */}
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 className="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
                <Icon name="file-text" className="w-6 h-6 text-brand-amber" />
                <span>Monthly Salary Slip Statement</span>
              </h2>
              <p className="text-xs text-neutral-400 mt-0.5">
                Statutory earnings breakdown, tax deductions, and authenticated PDF download.
              </p>
            </div>

            <div className="flex items-center gap-2.5">
              <select
                value={selectedMonth}
                onChange={(e) => setSelectedMonth(e.target.value)}
                className="px-3 py-2 rounded-xl bg-brand-surface border border-brand-border text-xs text-white focus:outline-none focus:border-brand-amber font-semibold"
              >
                <option value="October 2026">October 2026 (Disbursed)</option>
                <option value="September 2026">September 2026 (Disbursed)</option>
                <option value="August 2026">August 2026 (Disbursed)</option>
              </select>

              <button
                type="button"
                onClick={handleDownloadPdf}
                className="px-4 py-2 rounded-xl bg-brand-amber hover:bg-brand-amberLight text-neutral-950 font-bold text-xs shadow-lg shadow-brand-amber/20 flex items-center gap-2 transition-all cursor-pointer"
              >
                <Icon name="download" className="w-4 h-4" />
                <span>Download PDF</span>
              </button>

              <button
                type="button"
                onClick={() => window.print()}
                className="p-2 rounded-xl bg-brand-surface hover:bg-brand-card border border-brand-border text-neutral-300 hover:text-white text-xs transition-all cursor-pointer"
                title="Print Slip"
              >
                <Icon name="printer" className="w-4 h-4" />
              </button>
            </div>
          </div>

          {/* THE SALARY SLIP DOCUMENT CONTAINER */}
          <div
            id="printable-payslip-area"
            className="p-8 sm:p-12 rounded-3xl bg-brand-surface border border-brand-border shadow-2xl space-y-8 max-w-4xl mx-auto"
          >
            
            {/* Header Letterhead */}
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-brand-border">
              <div className="flex items-center gap-3">
                <img src="/sora-hr-logo.svg" alt="SORA HR" className="h-9 w-auto" onError={(e) => { e.target.src = '/sora-hr-logo.png'; }} />
                <div>
                  <h3 className="font-extrabold text-white text-base">Apex Global Technologies Pvt Ltd</h3>
                  <p className="text-[11px] text-neutral-400">Unit 604, Tower B, BKC Business Plaza, Mumbai 400051</p>
                  <p className="text-[10px] text-neutral-500 font-mono">CIN: U72900MH2021PTC368291 &bull; GSTIN: 27AABCA1234F1Z5</p>
                </div>
              </div>

              <div className="sm:text-right">
                <span className="px-3 py-1 rounded-full bg-brand-amber/15 text-brand-amber border border-brand-amber/30 text-xs font-bold">
                  PAYSLIP &bull; {selectedMonth}
                </span>
                <div className="text-[11px] text-neutral-400 font-mono mt-1">Payment Date: 05 Nov 2026</div>
              </div>
            </div>

            {/* Employee Demographic Details Matrix */}
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-2xl bg-brand-dark border border-brand-border text-xs">
              <div>
                <span className="text-[10px] text-neutral-500 uppercase font-bold block">Employee Name</span>
                <strong className="text-white font-semibold text-sm">{currentUser.name}</strong>
              </div>
              <div>
                <span className="text-[10px] text-neutral-500 uppercase font-bold block">Employee Code</span>
                <strong className="text-brand-amber font-mono font-bold text-sm">{currentUser.id}</strong>
              </div>
              <div>
                <span className="text-[10px] text-neutral-500 uppercase font-bold block">Designation</span>
                <span className="text-neutral-300">{currentUser.designation}</span>
              </div>
              <div>
                <span className="text-[10px] text-neutral-500 uppercase font-bold block">Department</span>
                <span className="text-neutral-300">{currentUser.department}</span>
              </div>

              <div>
                <span className="text-[10px] text-neutral-500 uppercase font-bold block">Bank &amp; A/C</span>
                <span className="text-neutral-300 font-mono">{currentUser.bank} &bull; {currentUser.accountNo}</span>
              </div>
              <div>
                <span className="text-[10px] text-neutral-500 uppercase font-bold block">PAN Number</span>
                <span className="text-neutral-300 font-mono">{currentUser.pan}</span>
              </div>
              <div>
                <span className="text-[10px] text-neutral-500 uppercase font-bold block">UAN &bull; PF Number</span>
                <span className="text-neutral-300 font-mono text-[11px]">{currentUser.uan}</span>
              </div>
              <div>
                <span className="text-[10px] text-neutral-500 uppercase font-bold block">Days Payable</span>
                <strong className="text-emerald-400 font-mono">29 / 31 (2 LOP)</strong>
              </div>
            </div>

            {/* Earnings & Deductions Columns */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              
              {/* Earnings Table */}
              <div className="space-y-3">
                <div className="pb-2 border-b border-brand-border flex justify-between text-xs font-bold text-emerald-400 uppercase">
                  <span>Earnings Breakdown</span>
                  <span>Amount (INR)</span>
                </div>
                <div className="space-y-2 text-xs">
                  <div className="flex justify-between text-neutral-300">
                    <span>Basic Salary</span>
                    <span className="font-mono">₹ 42,000.00</span>
                  </div>
                  <div className="flex justify-between text-neutral-300">
                    <span>House Rent Allowance (HRA)</span>
                    <span className="font-mono">₹ 21,000.00</span>
                  </div>
                  <div className="flex justify-between text-neutral-300">
                    <span>Special Allowance</span>
                    <span className="font-mono">₹ 12,500.00</span>
                  </div>
                  <div className="flex justify-between text-neutral-300">
                    <span>Conveyance Allowance</span>
                    <span className="font-mono">₹ 3,500.00</span>
                  </div>
                  <div className="flex justify-between text-neutral-300">
                    <span>Performance Incentive Bonus</span>
                    <span className="font-mono">₹ 5,000.00</span>
                  </div>
                </div>

                <div className="pt-3 border-t border-brand-border flex justify-between font-bold text-white text-xs">
                  <span>Gross Earnings (A)</span>
                  <span className="font-mono text-emerald-400 text-sm">₹ {grossEarnings.toLocaleString('en-IN')}.00</span>
                </div>
              </div>

              {/* Deductions Table */}
              <div className="space-y-3">
                <div className="pb-2 border-b border-brand-border flex justify-between text-xs font-bold text-rose-400 uppercase">
                  <span>Deductions &amp; Taxes</span>
                  <span>Amount (INR)</span>
                </div>
                <div className="space-y-2 text-xs">
                  <div className="flex justify-between text-neutral-300">
                    <span>Provident Fund (PF - 12%)</span>
                    <span className="font-mono">₹ 5,040.00</span>
                  </div>
                  <div className="flex justify-between text-neutral-300">
                    <span>Professional Tax (PT)</span>
                    <span className="font-mono">₹ 200.00</span>
                  </div>
                  <div className="flex justify-between text-neutral-300">
                    <span>Tax Deducted at Source (TDS)</span>
                    <span className="font-mono">₹ 4,200.00</span>
                  </div>
                  <div className="flex justify-between text-neutral-300">
                    <span>Loss of Pay (2 Days Unpaid)</span>
                    <span className="font-mono">₹ 2,710.00</span>
                  </div>
                </div>

                <div className="pt-3 border-t border-brand-border flex justify-between font-bold text-white text-xs">
                  <span>Total Deductions (B)</span>
                  <span className="font-mono text-rose-400 text-sm">₹ {totalDeductions.toLocaleString('en-IN')}.00</span>
                </div>
              </div>

            </div>

            {/* Net Pay Grand Highlight Card */}
            <div className="p-6 rounded-2xl bg-brand-dark border border-brand-amber/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <span className="text-[10px] text-brand-amber font-mono uppercase tracking-wider font-bold">
                  Net Salary Disbursed (A - B)
                </span>
                <div className="text-3xl sm:text-4xl font-extrabold font-mono text-white mt-1">
                  ₹ {netSalary.toLocaleString('en-IN')}.00
                </div>
                <p className="text-[11px] text-neutral-400 italic mt-0.5">
                  Amount in words: <strong className="text-neutral-200">{numberToWords(netSalary)}</strong>
                </p>
              </div>

              <div className="flex items-center gap-3 border-t sm:border-t-0 sm:border-l border-brand-border pt-3 sm:pt-0 sm:pl-6 text-right">
                <div>
                  <div className="text-[10px] text-neutral-400 uppercase font-mono">Disbursal Mode</div>
                  <div className="text-xs font-bold text-emerald-400 mt-0.5">Direct ACH / NEFT</div>
                  <div className="text-[9px] text-neutral-500 font-mono">UTR: HDFC9284729104</div>
                </div>
              </div>
            </div>

            {/* Footer Signatures */}
            <div className="pt-6 border-t border-brand-border flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 gap-4">
              <div>
                <p>This is a system-generated payslip authorized under SORA HRMS.</p>
                <p className="font-mono text-[10px] mt-0.5">Auth Code: SORA-ESS-2026-OCT-84920</p>
              </div>

              <div className="text-center sm:text-right">
                <div className="font-serif italic font-bold text-neutral-300 text-sm">Aarav Sharma</div>
                <div className="text-[10px] text-neutral-500">Chief Human Resources Officer (Authorized Signatory)</div>
              </div>
            </div>

          </div>

        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: TAB 5 — PAYROLL OVERVIEW (Ledger & Bulk Disbursals)
    // =========================================================================
    function PayrollTab({ payrollData, onSelectEmployeePayslip, onDisburseAll }) {
      const grossTotal = payrollData.reduce((acc, p) => acc + p.gross, 0);
      const deductionsTotal = payrollData.reduce((acc, p) => acc + p.deductions, 0);
      const netTotal = payrollData.reduce((acc, p) => acc + p.net, 0);

      return (
        <div className="space-y-6">
          
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 className="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
                <Icon name="dollar-sign" className="w-6 h-6 text-brand-amber" />
                <span>Enterprise Payroll &amp; Salary Disbursal</span>
              </h2>
              <p className="text-xs text-neutral-400 mt-0.5">
                Attendance-linked compensation calculations, PF/PT compliance, and net payout register.
              </p>
            </div>

            <button
              type="button"
              onClick={onDisburseAll}
              className="px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold text-xs shadow-lg shadow-emerald-500/20 flex items-center gap-2 transition-all cursor-pointer"
            >
              <Icon name="check-circle" className="w-4 h-4" />
              <span>Disburse Pending Salaries</span>
            </button>
          </div>

          {/* KPI Summary Cards */}
          <div className="grid grid-cols-1 sm:grid-cols-4 gap-4">
            <div className="p-5 rounded-2xl bg-brand-surface border border-brand-border space-y-1">
              <span className="text-[10px] text-neutral-400 font-semibold uppercase">Total Gross Payroll</span>
              <div className="text-2xl font-black font-mono text-white">₹ {grossTotal.toLocaleString('en-IN')}</div>
              <span className="text-[10px] text-neutral-500">4 Active Personnel</span>
            </div>
            <div className="p-5 rounded-2xl bg-brand-surface border border-brand-border space-y-1">
              <span className="text-[10px] text-neutral-400 font-semibold uppercase">Total Deductions (PF/TDS)</span>
              <div className="text-2xl font-black font-mono text-rose-400">₹ {deductionsTotal.toLocaleString('en-IN')}</div>
              <span className="text-[10px] text-neutral-500">Statutory Compliance</span>
            </div>
            <div className="p-5 rounded-2xl bg-brand-surface border border-brand-border space-y-1">
              <span className="text-[10px] text-neutral-400 font-semibold uppercase">Net Payable Outflow</span>
              <div className="text-2xl font-black font-mono text-emerald-400">₹ {netTotal.toLocaleString('en-IN')}</div>
              <span className="text-[10px] text-emerald-400">Bank ACH Transfer</span>
            </div>
            <div className="p-5 rounded-2xl bg-brand-surface border border-brand-border space-y-1">
              <span className="text-[10px] text-neutral-400 font-semibold uppercase">Scheduled Disbursal</span>
              <div className="text-2xl font-black font-mono text-brand-amber">05th Nov</div>
              <span className="text-[10px] text-neutral-500">Monthly auto-cycle</span>
            </div>
          </div>

          {/* Master Payroll Register Table */}
          <div className="p-6 rounded-3xl bg-brand-surface border border-brand-border space-y-4">
            <div className="flex items-center justify-between">
              <h3 className="text-sm font-bold text-white flex items-center gap-2">
                <Icon name="file-text" className="w-4 h-4 text-brand-amber" />
                <span>Monthly Personnel Compensation Ledger (October 2026)</span>
              </h3>
              <span className="text-xs font-mono text-neutral-400">{payrollData.length} Personnel</span>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full text-left text-xs border-collapse">
                <thead>
                  <tr className="border-b border-brand-border text-neutral-400 font-mono text-[11px]">
                    <th className="py-3 px-3">Emp ID</th>
                    <th className="py-3 px-3">Employee Name</th>
                    <th className="py-3 px-3">Department</th>
                    <th className="py-3 px-3">Days (Paid / Total)</th>
                    <th className="py-3 px-3">Gross Salary</th>
                    <th className="py-3 px-3">Deductions</th>
                    <th className="py-3 px-3">Net Disbursed</th>
                    <th className="py-3 px-3">Status</th>
                    <th className="py-3 px-3 text-right">Payslip</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-brand-border">
                  {payrollData.map(p => (
                    <tr key={p.empCode} className="hover:bg-brand-card/40 transition-colors">
                      <td className="py-3 px-3 font-mono font-bold text-brand-amber">{p.empCode}</td>
                      <td className="py-3 px-3 font-semibold text-white">{p.name}</td>
                      <td className="py-3 px-3 text-neutral-300">{p.dept}</td>
                      <td className="py-3 px-3 font-mono text-neutral-300">{p.paidDays} / {p.workingDays}d</td>
                      <td className="py-3 px-3 font-mono text-white">₹ {p.gross.toLocaleString('en-IN')}</td>
                      <td className="py-3 px-3 font-mono text-rose-400">₹ {p.deductions.toLocaleString('en-IN')}</td>
                      <td className="py-3 px-3 font-mono font-bold text-emerald-400">₹ {p.net.toLocaleString('en-IN')}</td>
                      <td className="py-3 px-3">
                        <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold border ${
                          p.status === 'Disbursed' ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30' :
                          'bg-amber-500/15 text-amber-300 border-amber-500/30 animate-pulse'
                        }`}>
                          {p.status}
                        </span>
                      </td>
                      <td className="py-3 px-3 text-right">
                        <button
                          type="button"
                          onClick={() => onSelectEmployeePayslip(p)}
                          className="px-2.5 py-1 rounded-lg bg-brand-dark hover:bg-brand-amber hover:text-neutral-950 border border-brand-border text-brand-amber font-semibold text-[11px] transition-all cursor-pointer"
                        >
                          View Slip
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: TAB 6 — ATTENDANCE XLS UPLOAD (Excel Parser via SheetJS)
    // =========================================================================
    function XlsUploadTab({ onImport, hrSettings }) {
      const [parsedRows, setParsedRows] = useState([]);
      const [fileName, setFileName] = useState('');
      const fileInputRef = useRef(null);

      // Download standard Excel attendance template
      const downloadTemplate = () => {
        if (!window.XLSX) {
          alert('SheetJS library loading. Please wait 2 seconds.');
          return;
        }

        const templateData = [
          { 'EmployeeCode': 'EMP-AGT-0104', 'EmployeeName': 'Pooja Iyer', 'Date': '2026-11-01', 'ClockIn': '09:28 AM', 'ClockOut': '06:30 PM', 'BreakMins': 45, 'Hours': '08h 17m', 'Status': 'Present' },
          { 'EmployeeCode': 'EMP-AGT-0105', 'EmployeeName': 'Vikram Rao', 'Date': '2026-11-01', 'ClockIn': '09:15 AM', 'ClockOut': '06:45 PM', 'BreakMins': 50, 'Hours': '08h 40m', 'Status': 'Present' },
          { 'EmployeeCode': 'EMP-AGT-0106', 'EmployeeName': 'Neha Patel', 'Date': '2026-11-01', 'ClockIn': '10:05 AM', 'ClockOut': '07:00 PM', 'BreakMins': 40, 'Hours': '08h 15m', 'Status': 'Late' },
          { 'EmployeeCode': 'EMP-AGT-0107', 'EmployeeName': 'Rohan Mehta', 'Date': '2026-11-01', 'ClockIn': '09:30 AM', 'ClockOut': '01:30 PM', 'BreakMins': 15, 'Hours': '03h 45m', 'Status': 'Half Day' }
        ];

        const ws = window.XLSX.utils.json_to_sheet(templateData);
        const wb = window.XLSX.utils.book_new();
        window.XLSX.utils.book_append_sheet(wb, ws, 'Attendance_Import');
        window.XLSX.writeFile(wb, 'sora_attendance_template.xlsx');
      };

      // Handle user file selection (.xlsx, .xls, .csv)
      const handleFileChange = (e) => {
        const file = e.target.files[0];
        if (!file) return;

        setFileName(file.name);
        const reader = new FileReader();

        reader.onload = (event) => {
          try {
            const data = new Uint8Array(event.target.result);
            const workbook = window.XLSX.read(data, { type: 'array' });
            const firstSheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[firstSheetName];
            const json = window.XLSX.utils.sheet_to_json(worksheet);

            setParsedRows(json);
          } catch (err) {
            alert('Error parsing Excel file. Please use a valid .xlsx or .csv format.');
          }
        };

        reader.readAsArrayBuffer(file);
      };

      const handleConfirmImport = () => {
        if (parsedRows.length === 0) return;
        onImport(parsedRows);
        setParsedRows([]);
        setFileName('');
        if (fileInputRef.current) fileInputRef.current.value = '';
      };

      return (
        <div className="space-y-6">
          
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 className="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
                <Icon name="upload" className="w-6 h-6 text-brand-amber" />
                <span>Attendance Excel / XLS Bulk Uploader</span>
              </h2>
              <p className="text-xs text-neutral-400 mt-0.5">
                Import biometric kiosk logs, batch punches, and multi-employee shift records via Excel or CSV.
              </p>
            </div>

            <button
              type="button"
              onClick={downloadTemplate}
              className="px-4 py-2.5 rounded-xl bg-brand-surface hover:bg-brand-card border border-brand-border text-brand-amber hover:text-white font-semibold text-xs flex items-center gap-2 transition-all shadow-sm cursor-pointer"
            >
              <Icon name="download" className="w-4 h-4" />
              <span>Download Excel Template (.xlsx)</span>
            </button>
          </div>

          {/* Drag & Drop Upload Container */}
          <div className="p-8 rounded-3xl bg-brand-surface border border-dashed border-brand-border hover:border-brand-amber/50 transition-all text-center space-y-4">
            <div className="w-16 h-16 rounded-2xl bg-brand-amber/10 border border-brand-amber/30 text-brand-amber flex items-center justify-center mx-auto">
              <Icon name="upload" className="w-8 h-8" />
            </div>

            <div>
              <h3 className="text-base font-bold text-white">Select or Drag &amp; Drop Attendance Spreadsheet</h3>
              <p className="text-xs text-neutral-400 mt-1">Supports Excel files (.xlsx, .xls) and standard CSV</p>
            </div>

            <input
              type="file"
              ref={fileInputRef}
              onChange={handleFileChange}
              accept=".xlsx, .xls, .csv"
              className="hidden"
              id="attendanceFileInput"
            />

            <div className="flex items-center justify-center gap-3">
              <label
                htmlFor="attendanceFileInput"
                className="px-5 py-2.5 rounded-xl bg-brand-amber hover:bg-brand-amberLight text-neutral-950 font-bold text-xs shadow-lg shadow-brand-amber/20 cursor-pointer transition-all"
              >
                Browse Excel File
              </label>
            </div>

            {fileName && (
              <div className="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-brand-dark border border-brand-border text-xs text-brand-amber font-mono">
                <Icon name="file-text" className="w-4 h-4" />
                <span>Loaded: {fileName} ({parsedRows.length} rows parsed)</span>
              </div>
            )}
          </div>

          {/* Parsed Data Preview Table */}
          {parsedRows.length > 0 && (
            <div className="p-6 rounded-3xl bg-brand-surface border border-brand-border space-y-4">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-sm font-bold text-white flex items-center gap-2">
                    <Icon name="check-circle" className="w-4 h-4 text-emerald-400" />
                    <span>Parsed Data Preview ({parsedRows.length} Rows Ready)</span>
                  </h3>
                  <p className="text-[11px] text-neutral-400">Review rows before merging into live system records.</p>
                </div>

                <button
                  type="button"
                  onClick={handleConfirmImport}
                  className="px-5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-black text-xs shadow-lg shadow-emerald-500/20 transition-all cursor-pointer"
                >
                  Confirm &amp; Import All {parsedRows.length} Records
                </button>
              </div>

              <div className="overflow-x-auto max-h-96">
                <table className="w-full text-left text-xs border-collapse">
                  <thead className="sticky top-0 bg-brand-surface">
                    <tr className="border-b border-brand-border text-neutral-400 font-mono text-[11px]">
                      <th className="py-2.5 px-3">Emp Code</th>
                      <th className="py-2.5 px-3">Name</th>
                      <th className="py-2.5 px-3">Date</th>
                      <th className="py-2.5 px-3">Clock In</th>
                      <th className="py-2.5 px-3">Clock Out</th>
                      <th className="py-2.5 px-3">Break</th>
                      <th className="py-2.5 px-3">Hours</th>
                      <th className="py-2.5 px-3">Status</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-brand-border">
                    {parsedRows.map((r, idx) => (
                      <tr key={idx} className="hover:bg-brand-card/40 transition-colors">
                        <td className="py-2.5 px-3 font-mono font-bold text-brand-amber">{r.EmployeeCode || r.EmpCode || '--'}</td>
                        <td className="py-2.5 px-3 font-semibold text-white">{r.EmployeeName || r.Name || '--'}</td>
                        <td className="py-2.5 px-3 font-mono text-neutral-300">{r.Date || '--'}</td>
                        <td className="py-2.5 px-3 font-mono text-emerald-400 font-bold">{r.ClockIn || '--'}</td>
                        <td className="py-2.5 px-3 font-mono text-neutral-300">{r.ClockOut || '--'}</td>
                        <td className="py-2.5 px-3 font-mono text-amber-300">{r.BreakMins || r.Break || '0'}m</td>
                        <td className="py-2.5 px-3 font-mono font-bold text-white">{r.Hours || '--'}</td>
                        <td className="py-2.5 px-3">
                          <span className="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                            {r.Status || 'Present'}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: MODAL A — LIVE SELFIE CAMERA CAPTURE (Core Requirement!)
    // =========================================================================
    function SelfieCameraModal({ hrSettings, currentUser, onCapture, onClose }) {
      const videoRef = useRef(null);
      const canvasRef = useRef(null);
      const [cameraStream, setCameraStream] = useState(null);
      const [cameraError, setCameraError] = useState(null);
      const [capturedPhotoUrl, setCapturedPhotoUrl] = useState(null);

      // Start webcam stream
      useEffect(() => {
        let activeStream = null;

        navigator.mediaDevices?.getUserMedia({ video: { facingMode: 'user', width: 640, height: 480 } })
          .then((stream) => {
            activeStream = stream;
            setCameraStream(stream);
            if (videoRef.current) {
              videoRef.current.srcObject = stream;
            }
          })
          .catch((err) => {
            console.warn('Webcam access failed or denied:', err);
            setCameraError('Camera access not granted or no webcam detected. You can proceed using the demo facial verification snapshot.');
          });

        return () => {
          if (activeStream) {
            activeStream.getTracks().forEach(t => t.stop());
          }
        };
      }, []);

      // Snap photo and draw GPS & timestamp watermark onto canvas
      const takeSnapshot = () => {
        if (!canvasRef.current) return;
        const canvas = canvasRef.current;
        const ctx = canvas.getContext('2d');
        const width = 640;
        const height = 480;
        canvas.width = width;
        canvas.height = height;

        if (videoRef.current && cameraStream) {
          ctx.drawImage(videoRef.current, 0, 0, width, height);
        } else {
          // Fallback mock portrait background
          ctx.fillStyle = '#101014';
          ctx.fillRect(0, 0, width, height);
          ctx.fillStyle = '#f59e0b';
          ctx.font = 'bold 24px sans-serif';
          ctx.fillText('FACIAL ATTENDANCE SNAPSHOT', 140, 240);
        }

        // Draw Watermark Overlay at bottom
        ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
        ctx.fillRect(0, height - 70, width, 70);

        ctx.fillStyle = '#f59e0b';
        ctx.font = 'bold 14px monospace';
        ctx.fillText(`EMP: ${currentUser.id} • ${currentUser.name}`, 15, height - 45);

        ctx.fillStyle = '#ffffff';
        ctx.font = '12px monospace';
        const nowStr = new Date().toLocaleString('en-IN');
        ctx.fillText(`TIME: ${nowStr} | GEOFENCE: ${hrSettings.officeName}`, 15, height - 25);
        ctx.fillText(`GPS: Lat ${hrSettings.officeLat.toFixed(4)}, Lng ${hrSettings.officeLng.toFixed(4)} • AES-256`, 15, height - 10);

        const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
        setCapturedPhotoUrl(dataUrl);

        // Stop camera
        if (cameraStream) {
          cameraStream.getTracks().forEach(t => t.stop());
        }
      };

      const handleConfirm = () => {
        if (capturedPhotoUrl) {
          onCapture(capturedPhotoUrl);
        } else {
          // If user didn't snap, snap automatically or generate demo snapshot
          takeSnapshot();
          setTimeout(() => {
            if (canvasRef.current) {
              onCapture(canvasRef.current.toDataURL('image/jpeg', 0.85));
            }
          }, 300);
        }
      };

      return (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-brand-surface border border-brand-border rounded-3xl max-w-md w-full p-6 space-y-5 shadow-2xl relative">
            
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2">
                <div className="w-8 h-8 rounded-xl bg-brand-amber/15 text-brand-amber flex items-center justify-center">
                  <Icon name="camera" className="w-4 h-4" />
                </div>
                <div>
                  <h3 className="text-sm font-bold text-white">HR Facial Attendance Verification</h3>
                  <p className="text-[10px] text-neutral-400">Position your face inside the target frame</p>
                </div>
              </div>
              <button onClick={onClose} className="text-neutral-400 hover:text-white p-1 cursor-pointer">
                <Icon name="x-circle" className="w-5 h-5" />
              </button>
            </div>

            {/* Viewfinder Frame with Oval Face Guide */}
            <div className="relative rounded-2xl overflow-hidden bg-black aspect-video flex items-center justify-center border border-brand-border">
              {capturedPhotoUrl ? (
                <img src={capturedPhotoUrl} alt="Captured" className="w-full h-full object-cover" />
              ) : (
                <>
                  <video
                    ref={videoRef}
                    autoPlay
                    playsInline
                    muted
                    className="w-full h-full object-cover"
                  />
                  {/* Oval Face Guide Reticle */}
                  <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div className="w-36 h-48 border-2 border-dashed border-brand-amber/80 rounded-full animate-pulse flex items-center justify-center">
                      <span className="text-[10px] text-brand-amber bg-black/60 px-2 py-0.5 rounded-full font-mono">
                        Center Face
                      </span>
                    </div>
                  </div>
                </>
              )}

              {/* Watermark badge on video */}
              <div className="absolute top-3 left-3 bg-black/70 backdrop-blur-sm px-2.5 py-1 rounded-lg text-[10px] font-mono text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5">
                <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span>Live GPS Geotag Active</span>
              </div>
            </div>

            <canvas ref={canvasRef} className="hidden" />

            {cameraError && (
              <div className="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs">
                {cameraError}
              </div>
            )}

            {/* Action Buttons */}
            <div className="flex items-center gap-3">
              {capturedPhotoUrl ? (
                <>
                  <button
                    type="button"
                    onClick={() => {
                      setCapturedPhotoUrl(null);
                      // restart stream
                      navigator.mediaDevices?.getUserMedia({ video: true }).then(s => {
                        setCameraStream(s);
                        if (videoRef.current) videoRef.current.srcObject = s;
                      });
                    }}
                    className="flex-1 py-3 rounded-xl bg-brand-dark hover:bg-brand-surface border border-brand-border text-neutral-300 font-semibold text-xs transition-all cursor-pointer"
                  >
                    Retake Photo
                  </button>
                  <button
                    type="button"
                    onClick={handleConfirm}
                    className="flex-1 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold text-xs shadow-lg shadow-emerald-500/20 transition-all cursor-pointer"
                  >
                    Confirm &amp; Clock In
                  </button>
                </>
              ) : (
                <button
                  type="button"
                  onClick={takeSnapshot}
                  className="w-full py-3.5 rounded-2xl bg-brand-amber hover:bg-brand-amberLight text-neutral-950 font-bold text-xs shadow-lg shadow-brand-amber/20 flex items-center justify-center gap-2 cursor-pointer transition-all"
                >
                  <Icon name="camera" className="w-4 h-4" />
                  <span>Capture Selfie &amp; Punch In</span>
                </button>
              )}
            </div>

          </div>
        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: MODAL B — QR CODE SCANNER (Kiosk Simulator)
    // =========================================================================
    function QrScannerModal({ onSuccess, onClose }) {
      const [isScanning, setIsScanning] = useState(true);

      useEffect(() => {
        const timer = setTimeout(() => {
          setIsScanning(false);
          setTimeout(() => {
            onSuccess();
          }, 800);
        }, 1800);
        return () => clearTimeout(timer);
      }, []);

      return (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-brand-surface border border-brand-border rounded-3xl max-w-sm w-full p-6 space-y-5 shadow-2xl text-center">
            
            <div className="flex items-center justify-between">
              <h3 className="text-sm font-bold text-white flex items-center gap-2">
                <Icon name="qr-code" className="w-4 h-4 text-brand-amber" />
                <span>Office Desk QR Scanner</span>
              </h3>
              <button onClick={onClose} className="text-neutral-400 hover:text-white p-1 cursor-pointer">
                <Icon name="x-circle" className="w-5 h-5" />
              </button>
            </div>

            <div className="relative rounded-2xl bg-brand-dark aspect-square border border-brand-border overflow-hidden flex items-center justify-center">
              <div className="w-44 h-44 border-2 border-brand-amber rounded-2xl relative flex items-center justify-center">
                <Icon name="qr-code" className="w-24 h-24 text-neutral-600" />
                
                {/* Laser scan line animation */}
                {isScanning && (
                  <div className="absolute left-0 right-0 h-0.5 bg-brand-amber shadow-[0_0_15px_#f59e0b] animate-bounce top-1/2"></div>
                )}
              </div>
            </div>

            <div>
              <div className="text-xs font-bold text-white">
                {isScanning ? 'Align camera with Office Desk Standee QR' : 'QR Verified Successfully!'}
              </div>
              <p className="text-[11px] text-neutral-400 mt-0.5 font-mono">
                Location: BKC Reception Standee #01
              </p>
            </div>

          </div>
        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: MODAL C — BREAK SELECTOR
    // =========================================================================
    function BreakSelectorModal({ onStartBreak, onClose }) {
      const breakTypes = [
        { name: 'Lunch Break', desc: 'Standard 45-60 min mid-shift meal break', icon: 'coffee' },
        { name: 'Tea / Coffee Break', desc: 'Quick 15 min refreshing beverage break', icon: 'coffee' },
        { name: 'Casual Break', desc: 'Short personal relaxation intermission', icon: 'clock' }
      ];

      return (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-brand-surface border border-brand-border rounded-3xl max-w-sm w-full p-6 space-y-4 shadow-2xl">
            
            <div className="flex items-center justify-between">
              <h3 className="text-sm font-bold text-white flex items-center gap-2">
                <Icon name="coffee" className="w-4 h-4 text-amber-400" />
                <span>Select Break Type</span>
              </h3>
              <button onClick={onClose} className="text-neutral-400 hover:text-white p-1 cursor-pointer">
                <Icon name="x-circle" className="w-5 h-5" />
              </button>
            </div>

            <div className="space-y-2">
              {breakTypes.map(b => (
                <button
                  key={b.name}
                  type="button"
                  onClick={() => onStartBreak(b.name)}
                  className="w-full p-3.5 rounded-2xl bg-brand-dark hover:bg-brand-card border border-brand-border hover:border-brand-amber/50 transition-all text-left flex items-center gap-3 cursor-pointer group"
                >
                  <div className="w-9 h-9 rounded-xl bg-brand-surface border border-brand-border flex items-center justify-center text-amber-400 group-hover:scale-105 transition-transform">
                    <Icon name={b.icon} className="w-4 h-4" />
                  </div>
                  <div>
                    <div className="text-xs font-bold text-white group-hover:text-brand-amber transition-colors">{b.name}</div>
                    <div className="text-[10px] text-neutral-400">{b.desc}</div>
                  </div>
                </button>
              ))}
            </div>

          </div>
        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: MODAL D — APPLY LEAVE
    // =========================================================================
    function ApplyLeaveModal({ leaveQuotas, onSubmit, onClose }) {
      const [type, setType] = useState('Casual Leave (CL)');
      const [fromDate, setFromDate] = useState('2026-11-12');
      const [toDate, setToDate] = useState('2026-11-13');
      const [reason, setReason] = useState('');
      const [days, setDays] = useState(2);

      const handleDateChange = (from, to) => {
        setFromDate(from);
        setToDate(to);
        const d1 = new Date(from);
        const d2 = new Date(to);
        const diff = Math.max(1, Math.round((d2 - d1) / (1000 * 60 * 60 * 24)) + 1);
        setDays(diff);
      };

      const handleSubmit = (e) => {
        e.preventDefault();
        if (!reason.trim()) {
          alert('Please enter a brief reason for leave.');
          return;
        }
        onSubmit({ type, fromDate, toDate, days, reason });
      };

      return (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-brand-surface border border-brand-border rounded-3xl max-w-md w-full p-6 space-y-5 shadow-2xl">
            
            <div className="flex items-center justify-between">
              <h3 className="text-sm font-bold text-white flex items-center gap-2">
                <Icon name="users" className="w-4 h-4 text-brand-amber" />
                <span>Apply for Leave</span>
              </h3>
              <button onClick={onClose} className="text-neutral-400 hover:text-white p-1 cursor-pointer">
                <Icon name="x-circle" className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleSubmit} className="space-y-4">
              
              <div>
                <label className="block text-xs font-semibold text-neutral-300 mb-1">Leave Category *</label>
                <select
                  value={type}
                  onChange={(e) => setType(e.target.value)}
                  className="w-full px-3 py-2.5 rounded-xl bg-brand-dark border border-brand-border text-xs text-white focus:outline-none focus:border-brand-amber"
                >
                  <option value="Casual Leave (CL)">Casual Leave (CL) &bull; 6d left</option>
                  <option value="Sick Leave (SL)">Sick Leave (SL) &bull; 5d left</option>
                  <option value="Privilege / Paid Leave (PL)">Privilege / Paid Leave (PL) &bull; 14d left</option>
                  <option value="Compensatory Off (CO)">Compensatory Off (CO) &bull; 2d left</option>
                </select>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-semibold text-neutral-300 mb-1">From Date *</label>
                  <input
                    type="date"
                    value={fromDate}
                    onChange={(e) => handleDateChange(e.target.value, toDate)}
                    required
                    className="w-full px-3 py-2 rounded-xl bg-brand-dark border border-brand-border text-xs text-white focus:outline-none focus:border-brand-amber font-mono"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-neutral-300 mb-1">To Date *</label>
                  <input
                    type="date"
                    value={toDate}
                    onChange={(e) => handleDateChange(fromDate, e.target.value)}
                    required
                    className="w-full px-3 py-2 rounded-xl bg-brand-dark border border-brand-border text-xs text-white focus:outline-none focus:border-brand-amber font-mono"
                  />
                </div>
              </div>

              <div className="p-3 rounded-xl bg-brand-dark border border-brand-border text-xs flex justify-between font-mono">
                <span className="text-neutral-400">Total Duration:</span>
                <strong className="text-brand-amber">{days} Working Day(s)</strong>
              </div>

              <div>
                <label className="block text-xs font-semibold text-neutral-300 mb-1">Reason for Leave *</label>
                <textarea
                  value={reason}
                  onChange={(e) => setReason(e.target.value)}
                  required
                  rows="3"
                  placeholder="e.g. Attending family function / Doctor consultation"
                  className="w-full px-3 py-2.5 rounded-xl bg-brand-dark border border-brand-border text-xs text-white focus:outline-none focus:border-brand-amber"
                ></textarea>
              </div>

              <button
                type="submit"
                className="w-full py-3 rounded-2xl bg-brand-amber hover:bg-brand-amberLight text-neutral-950 font-bold text-xs shadow-lg shadow-brand-amber/20 cursor-pointer transition-all"
              >
                Submit Leave Application
              </button>
            </form>

          </div>
        </div>
      );
    }

    // =========================================================================
    // SUB-COMPONENT: MODAL E — HR ATTENDANCE VERIFICATION POLICY (Core User Prompt Setting!)
    // =========================================================================
    function HrSettingsModal({ hrSettings, onSave, onClose }) {
      const [requireSelfie, setRequireSelfie] = useState(hrSettings.requireSelfie);
      const [requireGeo, setRequireGeo] = useState(hrSettings.requireGeo);
      const [strictGeofence, setStrictGeofence] = useState(hrSettings.strictGeofence);
      const [requireQrScan, setRequireQrScan] = useState(hrSettings.requireQrScan);
      const [officeName, setOfficeName] = useState(hrSettings.officeName);
      const [officeLat, setOfficeLat] = useState(hrSettings.officeLat);
      const [officeLng, setOfficeLng] = useState(hrSettings.officeLng);
      const [allowedRadiusMeters, setAllowedRadiusMeters] = useState(hrSettings.allowedRadiusMeters);

      const handleSave = () => {
        onSave({
          requireSelfie,
          requireGeo,
          strictGeofence,
          requireQrScan,
          officeName,
          officeLat: Number(officeLat),
          officeLng: Number(officeLng),
          allowedRadiusMeters: Number(allowedRadiusMeters)
        });
      };

      return (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-brand-surface border border-brand-border rounded-3xl max-w-lg w-full p-6 sm:p-8 space-y-6 shadow-2xl max-h-[90vh] overflow-y-auto">
            
            <div className="flex items-center justify-between pb-3 border-b border-brand-border">
              <div className="flex items-center gap-2.5">
                <div className="w-9 h-9 rounded-xl bg-brand-amber/15 text-brand-amber flex items-center justify-center">
                  <Icon name="settings" className="w-5 h-5" />
                </div>
                <div>
                  <h3 className="text-base font-bold text-white">HR Attendance Verification Policy</h3>
                  <p className="text-[11px] text-neutral-400">Admin &amp; HR Controlled Verification Permissions</p>
                </div>
              </div>
              <button onClick={onClose} className="text-neutral-400 hover:text-white p-1 cursor-pointer">
                <Icon name="x-circle" className="w-5 h-5" />
              </button>
            </div>

            {/* Core Toggles */}
            <div className="space-y-4">
              
              {/* TOGGLE 1: REQUIRE SELFIE (The exact setting requested by user) */}
              <div className="p-4 rounded-2xl bg-brand-dark border border-brand-border flex items-center justify-between gap-4">
                <div>
                  <div className="text-xs font-bold text-white flex items-center gap-2">
                    <Icon name="camera" className="w-4 h-4 text-brand-amber" />
                    <span>Require Facial Selfie for Clock In / Out</span>
                  </div>
                  <p className="text-[11px] text-neutral-400 mt-1 leading-relaxed">
                    When enabled, employees MUST capture a live camera photo before attendance is logged. Photo is stamped with GPS and timestamp.
                  </p>
                </div>
                <label className="relative inline-flex items-center cursor-pointer flex-shrink-0">
                  <input
                    type="checkbox"
                    checked={requireSelfie}
                    onChange={(e) => setRequireSelfie(e.target.checked)}
                    className="sr-only peer"
                  />
                  <div className="w-11 h-6 bg-neutral-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-amber"></div>
                </label>
              </div>

              {/* TOGGLE 2: REQUIRE GEOLOCATION */}
              <div className="p-4 rounded-2xl bg-brand-dark border border-brand-border flex items-center justify-between gap-4">
                <div>
                  <div className="text-xs font-bold text-white flex items-center gap-2">
                    <Icon name="map-pin" className="w-4 h-4 text-emerald-400" />
                    <span>Require GPS Geolocation Tracking</span>
                  </div>
                  <p className="text-[11px] text-neutral-400 mt-1 leading-relaxed">
                    Fetches real-time GPS coordinates and measures proximity against the company geofence boundary.
                  </p>
                </div>
                <label className="relative inline-flex items-center cursor-pointer flex-shrink-0">
                  <input
                    type="checkbox"
                    checked={requireGeo}
                    onChange={(e) => setRequireGeo(e.target.checked)}
                    className="sr-only peer"
                  />
                  <div className="w-11 h-6 bg-neutral-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-amber"></div>
                </label>
              </div>

              {/* TOGGLE 3: REQUIRE QR CODE */}
              <div className="p-4 rounded-2xl bg-brand-dark border border-brand-border flex items-center justify-between gap-4">
                <div>
                  <div className="text-xs font-bold text-white flex items-center gap-2">
                    <Icon name="qr-code" className="w-4 h-4 text-sky-400" />
                    <span>Require Office Desk QR Scan</span>
                  </div>
                  <p className="text-[11px] text-neutral-400 mt-1 leading-relaxed">
                    Mandates scanning physical reception QR standee before punch confirmation.
                  </p>
                </div>
                <label className="relative inline-flex items-center cursor-pointer flex-shrink-0">
                  <input
                    type="checkbox"
                    checked={requireQrScan}
                    onChange={(e) => setRequireQrScan(e.target.checked)}
                    className="sr-only peer"
                  />
                  <div className="w-11 h-6 bg-neutral-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-amber"></div>
                </label>
              </div>

              {/* Office Geofence Coordinates Config */}
              <div className="p-4 rounded-2xl bg-brand-dark border border-brand-border space-y-3">
                <div className="text-xs font-bold text-neutral-200">Office Geofence Boundary Coordinates</div>
                
                <div>
                  <label className="block text-[11px] text-neutral-400 mb-1">Office Name / Branch</label>
                  <input
                    type="text"
                    value={officeName}
                    onChange={(e) => setOfficeName(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl bg-brand-surface border border-brand-border text-xs text-white focus:outline-none focus:border-brand-amber"
                  />
                </div>

                <div className="grid grid-cols-3 gap-2">
                  <div>
                    <label className="block text-[10px] text-neutral-400 mb-1">Latitude</label>
                    <input
                      type="number"
                      step="0.0001"
                      value={officeLat}
                      onChange={(e) => setOfficeLat(e.target.value)}
                      className="w-full px-2.5 py-1.5 rounded-lg bg-brand-surface border border-brand-border text-xs text-white font-mono"
                    />
                  </div>
                  <div>
                    <label className="block text-[10px] text-neutral-400 mb-1">Longitude</label>
                    <input
                      type="number"
                      step="0.0001"
                      value={officeLng}
                      onChange={(e) => setOfficeLng(e.target.value)}
                      className="w-full px-2.5 py-1.5 rounded-lg bg-brand-surface border border-brand-border text-xs text-white font-mono"
                    />
                  </div>
                  <div>
                    <label className="block text-[10px] text-neutral-400 mb-1">Radius (Meters)</label>
                    <input
                      type="number"
                      value={allowedRadiusMeters}
                      onChange={(e) => setAllowedRadiusMeters(e.target.value)}
                      className="w-full px-2.5 py-1.5 rounded-lg bg-brand-surface border border-brand-border text-xs text-white font-mono"
                    />
                  </div>
                </div>
              </div>

            </div>

            <div className="flex items-center gap-3 pt-2">
              <button
                type="button"
                onClick={onClose}
                className="flex-1 py-3 rounded-2xl bg-brand-dark hover:bg-brand-card border border-brand-border text-neutral-300 font-semibold text-xs transition-all cursor-pointer"
              >
                Cancel
              </button>
              <button
                type="button"
                onClick={handleSave}
                className="flex-1 py-3 rounded-2xl bg-brand-amber hover:bg-brand-amberLight text-neutral-950 font-bold text-xs shadow-lg shadow-brand-amber/20 transition-all cursor-pointer"
              >
                Save HR Verification Policy
              </button>
            </div>

          </div>
        </div>
      );
    }

    // =========================================================================
    // INITIAL MOUNT
    // =========================================================================
    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>